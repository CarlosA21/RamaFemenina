<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.DonacionesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:models="using:RamaFemenina.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,16">
            <TextBlock 
                Text="Gestión de Donaciones"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,8"/>
            <TextBlock 
                Text="Administra todas las donaciones realizadas a pacientes"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton 
                    Icon="Add" 
                    Label="Nueva Donación"
                    Click="BtnNuevaDonacion_Click"/>
                <AppBarButton 
                    Icon="Edit" 
                    Label="Editar"
                    Click="BtnEditarDonacion_Click"
                    IsEnabled="{x:Bind IsDonacionSelected, Mode=OneWay}"/>
                <AppBarButton 
                    Icon="Delete" 
                    Label="Eliminar"
                    Click="BtnEliminarDonacion_Click"
                    IsEnabled="{x:Bind IsDonacionSelected, Mode=OneWay}"/>
                <AppBarSeparator/>
                <AppBarButton 
                    Icon="Contact" 
                    Label="Ver Paciente"
                    Click="BtnVerPaciente_Click"
                    IsEnabled="{x:Bind IsDonacionSelected, Mode=OneWay}"/>
                <AppBarButton 
                    Icon="Refresh" 
                    Label="Actualizar"
                    Click="BtnActualizar_Click"/>
            </CommandBar>

            <!-- Search Bar -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Row="1"
                PlaceholderText="Buscar por paciente, cédula, procedimiento, monto..."
                QueryIcon="Find"
                Margin="0,8,0,16"
                TextChanged="SearchBox_TextChanged"/>

            <!-- DataGrid / ListView -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Border 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ListView
                            x:Name="DonacionesListView"
                            SelectionMode="Single"
                            SelectionChanged="DonacionesListView_SelectionChanged">
                            <ListView.Header>
                                <Grid Padding="16,12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" MinWidth="1400">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="180"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="ID" FontWeight="SemiBold" Grid.Column="0"/>
                                    <TextBlock Text="Fecha" FontWeight="SemiBold" Grid.Column="1"/>
                                    <TextBlock Text="Cédula Paciente" FontWeight="SemiBold" Grid.Column="2"/>
                                    <TextBlock Text="Procedimiento" FontWeight="SemiBold" Grid.Column="3"/>
                                    <TextBlock Text="Observaciones" FontWeight="SemiBold" Grid.Column="4"/>
                                    <TextBlock Text="Monto Solicitado" FontWeight="SemiBold" Grid.Column="5"/>
                                    <TextBlock Text="Valor Donación" FontWeight="SemiBold" Grid.Column="6"/>
                                    <TextBlock Text="Total" FontWeight="SemiBold" Grid.Column="7"/>
                                    <TextBlock Text="Estado" FontWeight="SemiBold" Grid.Column="8"/>
                                </Grid>
                            </ListView.Header>
                            
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Donaciones">
                                    <Grid Padding="16,12" MinWidth="1400">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="250"/>
                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="180"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{x:Bind idDonacion}" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind FechaFormateada}" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind idPaciente}" Grid.Column="2" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind procedimiento}" Grid.Column="3" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind observacion}" Grid.Column="4" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" VerticalAlignment="Center">
                                            <Run Text="$"/>
                                            <Run Text="{x:Bind montoSolicitado}"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="6" VerticalAlignment="Center">
                                            <Run Text="$"/>
                                            <Run Text="{x:Bind valor}" FontWeight="SemiBold"/>
                                        </TextBlock>
                                        <TextBlock Grid.Column="7" VerticalAlignment="Center">
                                            <Run Text="$"/>
                                            <Run Text="{x:Bind total}" FontWeight="Bold"/>
                                        </TextBlock>
                                        <Border Grid.Column="8" 
                                                CornerRadius="12" 
                                                Padding="8,4"
                                                HorizontalAlignment="Left"
                                                Background="{x:Bind EstadoColor}">
                                            <TextBlock Text="{x:Bind EstadoTexto}" 
                                                       FontSize="12" 
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </ScrollViewer>
                </Border>

                <!-- Empty State -->
                <StackPanel 
                    x:Name="EmptyState"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <TextBlock 
                        Text="💰"
                        FontSize="72"
                        HorizontalAlignment="Center"/>
                    <TextBlock 
                        Text="No hay donaciones registradas"
                        FontSize="20"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>
                    <TextBlock 
                        Text="Haz clic en 'Nueva Donación' para comenzar"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Summary Panel -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Border 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="TotalDonacionesText" Text="Total de donaciones: 0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                            <FontIcon Glyph="&#xE7BF;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <TextBlock x:Name="TotalSolicitadoText" Text="Total solicitado: $0.00" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                            <FontIcon Glyph="&#xE8EC;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <TextBlock x:Name="TotalDonadoText" Text="Total donado: $0.00" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                            <FontIcon Glyph="&#xE8AB;" FontSize="16" Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                            <TextBlock x:Name="DiferenciaText" Text="Diferencia: $0.00" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
