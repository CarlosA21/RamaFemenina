<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.CajaChicaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:models="using:RamaFemenina.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,16">
            <TextBlock 
                Text="💵 Desembolso de Caja Chica"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,8"/>
            <TextBlock 
                Text="Gestión de desembolsos y pagos de caja chica"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton 
                    Icon="Add" 
                    Label="Nuevo Desembolso"
                    Click="BtnNuevo_Click"/>
                <AppBarButton 
                    Icon="Edit" 
                    Label="Editar"
                    Click="BtnEditar_Click"
                    IsEnabled="{x:Bind IsItemSelected, Mode=OneWay}"/>
                <AppBarButton 
                    Icon="Delete" 
                    Label="Eliminar"
                    Click="BtnEliminar_Click"
                    IsEnabled="{x:Bind IsItemSelected, Mode=OneWay}"/>
                <AppBarSeparator/>
                <AppBarButton 
                    Icon="Print" 
                    Label="Imprimir"
                    Click="BtnImprimir_Click"
                    IsEnabled="{x:Bind IsItemSelected, Mode=OneWay}"/>
            </CommandBar>

            <!-- Search Bar -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Row="1"
                PlaceholderText="🔍 Buscar por nombre, recibo, concepto o monto..."
                QueryIcon="Find"
                Margin="0,8,0,16"
                TextChanged="SearchBox_TextChanged"/>

            <!-- DataGrid -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <Border 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ListView
                            x:Name="DesembolsosListView"
                            SelectionMode="Single"
                            SelectionChanged="ListView_SelectionChanged">
                            <ListView.Header>
                                <Grid Padding="16,12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" MinWidth="1200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="*" MinWidth="200"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="200"/>
                                        <ColumnDefinition Width="*" MinWidth="250"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="No. Recibo" FontWeight="SemiBold" Grid.Column="0"/>
                                    <TextBlock Text="Fecha" FontWeight="SemiBold" Grid.Column="1"/>
                                    <TextBlock Text="Pagado a" FontWeight="SemiBold" Grid.Column="2"/>
                                    <TextBlock Text="Monto (RD$)" FontWeight="SemiBold" Grid.Column="3"/>
                                    <TextBlock Text="Con cargo a" FontWeight="SemiBold" Grid.Column="4"/>
                                    <TextBlock Text="Por concepto de" FontWeight="SemiBold" Grid.Column="5"/>
                                </Grid>
                            </ListView.Header>
                            
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:CajaChica">
                                    <Grid Padding="16,12" MinWidth="1200">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="*" MinWidth="200"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="200"/>
                                            <ColumnDefinition Width="*" MinWidth="250"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="{x:Bind NumeroRecibo}" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind FechaFormateada}" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind PagadoA}" Grid.Column="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{x:Bind MontoColor}">
                                            <Run Text="$"/>
                                            <Run Text="{x:Bind Monto}"/>
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind ConCargoA}" Grid.Column="4" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind Concepto}" Grid.Column="5" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </ScrollViewer>
                </Border>

                <!-- Empty State -->
                <StackPanel 
                    x:Name="EmptyState"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <TextBlock 
                        Text="💵"
                        FontSize="72"
                        HorizontalAlignment="Center"/>
                    <TextBlock 
                        Text="No hay desembolsos registrados"
                        FontSize="20"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>
                    <TextBlock 
                        Text="Haz clic en 'Nuevo Desembolso' para comenzar"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Summary Panel -->
            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Border 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="TotalDesembolsosText" Text="Total de desembolsos: 0" VerticalAlignment="Center"/>
                        </StackPanel>
                        
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8EC;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <TextBlock x:Name="TotalMontoText" Text="Monto total: $0.00" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="Green" FontSize="16"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
