<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.CajaChicaPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:models="using:RamaFemenina.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Animaciones -->
        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="20" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Estilos -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="MinHeight" Value="140"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Gradiente para Caja Chica (Naranja/Amarillo - dinero) -->
        <LinearGradientBrush x:Key="CajaChicaGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#f7971e" Offset="0"/>
            <GradientStop Color="#ffd200" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid x:Name="MainContent" Margin="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,20,40,20">
            <Grid MaxWidth="1600" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Premium -->
                <Border Grid.Row="0" 
                       CornerRadius="16" 
                       Padding="32,28"
                       Margin="0,0,0,24"
                       Background="{StaticResource CajaChicaGradient}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Viewbox Width="40" Height="40">
                                    <FontIcon Glyph="&#xE8B7;" Foreground="White"/>
                                </Viewbox>
                                <TextBlock Text="Caja Chica - Desembolsos"
                                          FontSize="32"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Gestión y control de desembolsos y pagos de caja chica"
                                      FontSize="16"
                                      Foreground="#FFF8E1"
                                      Opacity="0.9"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" 
                                   VerticalAlignment="Center" 
                                   Orientation="Horizontal" 
                                   Spacing="12">
                            <Button Style="{StaticResource IconButton}"
                                   Background="#FFFFFF20"
                                   BorderThickness="0"
                                   ToolTipService.ToolTip="Actualizar datos">
                                <FontIcon Glyph="&#xE72C;" Foreground="White" FontSize="20"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                   Background="#FFFFFF20"
                                   BorderThickness="0"
                                   ToolTipService.ToolTip="Generar reporte">
                                <FontIcon Glyph="&#xE8A7;" Foreground="White" FontSize="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Estadísticas -->
                <Grid Grid.Row="1" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Desembolsos -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource CajaChicaGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8B7;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtTotalDesembolsos" 
                                          Text="0" 
                                          FontSize="36" 
                                          FontWeight="Bold"/>
                                <TextBlock Text="Total Desembolsos" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74E;" FontSize="12" Foreground="#f7971e"/>
                                <TextBlock Text="+12 este mes" FontSize="12" Foreground="#f7971e"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Monto Total -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource SuccessGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8EC;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtMontoTotal" 
                                          Text="RD$ 0.00" 
                                          FontSize="30" 
                                          FontWeight="Bold"
                                          Foreground="#f7971e"/>
                                <TextBlock Text="Monto Total Pagado" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" Value="68" Foreground="#f7971e" Height="4"/>
                        </Grid>
                    </Border>

                    <!-- Promedio -->
                    <Border Grid.Column="4" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource InfoGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8B3;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtPromedio" 
                                          Text="RD$ 0.00" 
                                          FontSize="30" 
                                          FontWeight="Bold"/>
                                <TextBlock Text="Promedio por Desembolso" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Border Grid.Row="2" 
                                   Background="{ThemeResource AccentAAFillColorTertiaryBrush}"
                                   CornerRadius="8"
                                   Padding="8,4">
                                <TextBlock Text="Por pago" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Toolbar -->
                <Border Grid.Row="2" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Búsqueda -->
                        <Border Grid.Column="0" 
                               Background="{ThemeResource ControlFillColorDefaultBrush}"
                               CornerRadius="10"
                               Padding="16,0"
                               Height="52"
                               BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                               BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE721;" 
                                         Grid.Column="0"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                         FontSize="20"
                                         Margin="0,0,12,0"/>

                                <AutoSuggestBox x:Name="SearchBox"
                                               Grid.Column="1"
                                               PlaceholderText="Buscar por nombre, recibo, concepto, cargo o monto..."
                                               TextChanged="SearchBox_TextChanged"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Botones -->
                        <StackPanel Grid.Column="1" 
                                   Orientation="Horizontal" 
                                   Spacing="12" 
                                   Margin="20,0,0,0">
                            <Button Click="BtnNuevo_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="{StaticResource CajaChicaGradient}"
                                   Foreground="White"
                                   BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE710;" FontSize="18"/>
                                    <TextBlock Text="Nuevo Desembolso" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnEditar"
                                   Click="BtnEditar_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="{ThemeResource SystemFillColorAttentionBrush}"
                                   IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="16"/>
                                    <TextBlock Text="Editar" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnEliminar"
                                   Click="BtnEliminar_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="{StaticResource DangerGradient}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                    <TextBlock Text="Eliminar" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnImprimir"
                                   Click="BtnImprimir_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="{StaticResource PrimaryGradient}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE749;" FontSize="16"/>
                                    <TextBlock Text="Imprimir" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tabs -->
                <Border Grid.Row="3" 
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       CornerRadius="12"
                       Padding="8"
                       Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <ToggleButton Content="💵 Lista" IsChecked="True" MinWidth="100" Height="40" CornerRadius="8"/>
                            <ToggleButton Content="📊 Resumen" MinWidth="120" Height="40" CornerRadius="8"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Total:"/>
                            <Run x:Name="txtContador" Text="0" FontWeight="Bold"/>
                            <Run Text="desembolsos"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Lista Premium -->
                <Border Grid.Row="4" Style="{StaticResource ModernCard}" MinHeight="400">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                     VerticalScrollBarVisibility="Auto"
                                     x:Name="ListViewScroller"
                                     Visibility="Visible">
                            <ListView x:Name="DesembolsosListView"
                                     SelectionMode="Single"
                                     SelectionChanged="ListView_SelectionChanged"
                                     CornerRadius="8">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                               CornerRadius="8,8,0,0"
                                               Padding="20,16"
                                               MinWidth="1400">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="N° RECIBO" Grid.Column="0" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="FECHA" Grid.Column="1" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="PAGADO A" Grid.Column="2" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="MONTO (RD$)" Grid.Column="3" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="CON CARGO A" Grid.Column="4" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="POR CONCEPTO DE" Grid.Column="5" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>

                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:CajaChica">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                               CornerRadius="8"
                                               Padding="20,16"
                                               Margin="0,1"
                                               MinWidth="1400"
                                               BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                               BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                       Background="{ThemeResource SystemFillColorSolidNeutralBrush}"
                                                       CornerRadius="8"
                                                       Padding="12,8"
                                                       VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind NumeroRecibo}"
                                                              FontFamily="Consolas"
                                                              FontSize="13"
                                                              FontWeight="Bold"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              TextAlignment="Center"/>
                                                </Border>

                                                <TextBlock Text="{x:Bind FechaFormateada}" 
                                                          Grid.Column="1"
                                                          VerticalAlignment="Center"
                                                          FontSize="13"/>

                                                <TextBlock Text="{x:Bind PagadoA}" 
                                                          Grid.Column="2"
                                                          VerticalAlignment="Center"
                                                          FontSize="14"
                                                          FontWeight="SemiBold"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="15" Foreground="#f7971e">
                                                    <Run Text="RD$ "/>
                                                    <Run Text="{x:Bind Monto}" FontWeight="Bold"/>
                                                </TextBlock>

                                                <TextBlock Text="{x:Bind ConCargoA}" 
                                                          Grid.Column="4"
                                                          VerticalAlignment="Center"
                                                          FontSize="12"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{x:Bind Concepto}" 
                                                          Grid.Column="5"
                                                          VerticalAlignment="Center"
                                                          FontSize="12"
                                                          FontStyle="Italic"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyState"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Spacing="32"
                                   Padding="40">
                            <Viewbox Width="200" Height="200">
                                <Grid>
                                    <Ellipse Fill="{StaticResource CajaChicaGradient}" Opacity="0.1"/>
                                    <FontIcon Glyph="&#xE8B7;" 
                                             Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                             FontSize="120"/>
                                </Grid>
                            </Viewbox>
                            
                            <StackPanel Spacing="12">
                                <TextBlock Text="No hay desembolsos registrados"
                                          FontSize="28"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Comienza registrando el primer desembolso de caja chica"
                                          HorizontalAlignment="Center"
                                          TextAlignment="Center"
                                          MaxWidth="500"
                                          TextWrapping="Wrap"
                                          FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Button Click="BtnNuevo_Click"
                                   Background="{StaticResource CajaChicaGradient}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Height="56"
                                   MinWidth="220"
                                   CornerRadius="12"
                                   FontSize="16"
                                   FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE710;" FontSize="20"/>
                                    <TextBlock Text="Primer Desembolso"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
