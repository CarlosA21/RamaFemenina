<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.ReciboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:models="using:RamaFemenina.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,16">
            <TextBlock 
                Text="Gestión de Recibos de Ingreso"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,8"/>
            <TextBlock 
                Text="Administra todos los recibos de ingreso y pagos recibidos"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton 
                    Icon="Add" 
                    Label="Nuevo Recibo"
                    Click="BtnNuevoRecibo_Click"/>
                <AppBarButton 
                    Icon="Edit" 
                    Label="Editar"
                    Click="BtnEditarRecibo_Click"
                    IsEnabled="{x:Bind IsReciboSelected, Mode=OneWay}"/>
                <AppBarButton 
                    Icon="Delete" 
                    Label="Eliminar"
                    Click="BtnEliminarRecibo_Click"
                    IsEnabled="{x:Bind IsReciboSelected, Mode=OneWay}"/>
                <AppBarSeparator/>
                <AppBarButton 
                    Icon="Print" 
                    Label="Imprimir"
                    Click="BtnImprimirRecibo_Click"
                    IsEnabled="{x:Bind IsReciboSelected, Mode=OneWay}"/>
                <AppBarButton 
                    Icon="Page" 
                    Label="Generar Reporte"
                    Click="BtnGenerarReporte_Click"/>
            </CommandBar>

            <!-- Search Bar -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Row="1"
                PlaceholderText="Buscar por número, nombre, concepto, cheque..."
                QueryIcon="Find"
                Margin="0,8,0,8"
                TextChanged="SearchBox_TextChanged"/>

            <!-- Filter Panel -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="12" Margin="0,0,0,12">
                <ComboBox 
                    x:Name="FiltroFechaCombo"
                    Header="Filtrar por:"
                    PlaceholderText="Todas las fechas"
                    MinWidth="200"
                    SelectionChanged="FiltroFecha_SelectionChanged">
                    <ComboBoxItem Content="Todas las fechas"/>
                    <ComboBoxItem Content="Hoy"/>
                    <ComboBoxItem Content="Esta semana"/>
                    <ComboBoxItem Content="Este mes"/>
                    <ComboBoxItem Content="Rango personalizado..."/>
                </ComboBox>

                <ComboBox 
                    x:Name="FiltroPagoCombo"
                    Header="Tipo de pago:"
                    PlaceholderText="Todos"
                    MinWidth="150"
                    SelectionChanged="FiltroPago_SelectionChanged">
                    <ComboBoxItem Content="Todos"/>
                    <ComboBoxItem Content="Efectivo"/>
                    <ComboBoxItem Content="Transferencia"/>
                    <ComboBoxItem Content="Cheque"/>
                </ComboBox>

                <ComboBox 
                    x:Name="OrdenarCombo"
                    Header="Ordenar por:"
                    MinWidth="180"
                    SelectionChanged="Ordenar_SelectionChanged">
                    <ComboBoxItem Content="Fecha (Reciente)" IsSelected="True"/>
                    <ComboBoxItem Content="Fecha (Antigua)"/>
                    <ComboBoxItem Content="Monto (Mayor)"/>
                    <ComboBoxItem Content="Monto (Menor)"/>
                    <ComboBoxItem Content="Número de Recibo"/>
                </ComboBox>
            </StackPanel>

            <!-- DataGrid / ListView -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Border 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                        <ListView
                            x:Name="RecibosListView"
                            SelectionMode="Single"
                            SelectionChanged="RecibosListView_SelectionChanged">
                            <ListView.Header>
                                <Grid Padding="16,12" Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}" MinWidth="1400">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="300"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="*" MinWidth="250"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="200"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="No. Recibo" FontWeight="SemiBold" Grid.Column="0"/>
                                    <TextBlock Text="Fecha" FontWeight="SemiBold" Grid.Column="1"/>
                                    <TextBlock Text="Recibimos de" FontWeight="SemiBold" Grid.Column="2"/>
                                    <TextBlock Text="Monto (RD$)" FontWeight="SemiBold" Grid.Column="3"/>
                                    <TextBlock Text="Concepto" FontWeight="SemiBold" Grid.Column="4"/>
                                    <TextBlock Text="Tipo de Pago" FontWeight="SemiBold" Grid.Column="5"/>
                                    <TextBlock Text="Detalles" FontWeight="SemiBold" Grid.Column="6"/>
                                </Grid>
                            </ListView.Header>
                            
                            <ListView.ItemTemplate>
                                <DataTemplate x:DataType="models:Recibo">
                                    <Grid Padding="16,12" MinWidth="1400">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="100"/>
                                            <ColumnDefinition Width="120"/>
                                            <ColumnDefinition Width="300"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="*" MinWidth="250"/>
                                            <ColumnDefinition Width="150"/>
                                            <ColumnDefinition Width="200"/>
                                        </Grid.ColumnDefinitions>
                                        
                                        <TextBlock Text="{x:Bind NumeroRecibo}" Grid.Column="0" VerticalAlignment="Center" FontWeight="SemiBold"/>
                                        <TextBlock Text="{x:Bind FechaFormateada}" Grid.Column="1" VerticalAlignment="Center"/>
                                        <TextBlock Text="{x:Bind RecibimosDe}" Grid.Column="2" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" VerticalAlignment="Center" FontWeight="SemiBold">
                                            <Run Text="$"/>
                                            <Run Text="{x:Bind Monto}"/>
                                        </TextBlock>
                                        <TextBlock Text="{x:Bind Concepto}" Grid.Column="4" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                        
                                        <Border Grid.Column="5" 
                                                CornerRadius="12" 
                                                Padding="8,4"
                                                HorizontalAlignment="Left"
                                                Background="{x:Bind TipoPagoColor}">
                                            <TextBlock Text="{x:Bind TipoPago}" 
                                                       FontSize="12" 
                                                       FontWeight="SemiBold"
                                                       Foreground="White"/>
                                        </Border>
                                        
                                        <TextBlock Text="{x:Bind DetallesPago}" Grid.Column="6" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" FontSize="12"/>
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>

                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                            </ListView.ItemContainerStyle>
                        </ListView>
                    </ScrollViewer>
                </Border>

                <!-- Empty State -->
                <StackPanel 
                    x:Name="EmptyState"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <TextBlock 
                        Text="🧾"
                        FontSize="72"
                        HorizontalAlignment="Center"/>
                    <TextBlock 
                        Text="No hay recibos registrados"
                        FontSize="20"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>
                    <TextBlock 
                        Text="Haz clic en 'Nuevo Recibo' para comenzar"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>

            <!-- Summary Panel -->
            <Grid Grid.Row="4" Margin="0,16,0,0">
                <Border 
                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE8F1;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                            <TextBlock x:Name="TotalRecibosText" Text="Total de recibos: 0" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                            <FontIcon Glyph="&#xE8EC;" FontSize="16" Foreground="{ThemeResource SystemFillColorSuccessBrush}"/>
                            <TextBlock x:Name="TotalEfectivoText" Text="Efectivo: $0.00" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                            <FontIcon Glyph="&#xE7BF;" FontSize="16" Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                            <TextBlock x:Name="TotalTransferenciaText" Text="Transferencia: $0.00" VerticalAlignment="Center"/>
                        </StackPanel>

                        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" Margin="24,0,0,0">
                            <FontIcon Glyph="&#xE8AB;" FontSize="16" Foreground="{ThemeResource SystemFillColorCautionBrush}"/>
                            <TextBlock x:Name="TotalChequeText" Text="Cheque: $0.00" VerticalAlignment="Center" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</Page>
