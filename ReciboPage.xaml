<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.ReciboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:models="using:RamaFemenina.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Animaciones -->
        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="20" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Estilos -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="120"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <!-- Gradientes -->
        <LinearGradientBrush x:Key="ReciboGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4facfe" Offset="0"/>
            <GradientStop Color="#00f2fe" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11998e" Offset="0"/>
            <GradientStop Color="#38ef7d" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#eb3349" Offset="0"/>
            <GradientStop Color="#f45c43" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#f2994a" Offset="0"/>
            <GradientStop Color="#f2c94c" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid x:Name="MainContent">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>

        <Grid Padding="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Mejorado -->
            <Border Grid.Row="0" 
                   CornerRadius="16" 
                   Padding="32,24"
                   Margin="0,0,0,20"
                   Background="{StaticResource ReciboGradient}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="#FFFFFF30" 
                                   Width="48" Height="48" 
                                   CornerRadius="12"
                                   Padding="10">
                                <FontIcon Glyph="&#xE8A1;" Foreground="White" FontSize="24"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Gestión de Recibos"
                                          FontSize="28"
                                          FontWeight="Bold"
                                          Foreground="White"/>
                                <TextBlock Text="Administra ingresos, egresos y facturas fiscales NCF"
                                          FontSize="14"
                                          Foreground="#E8EAED"
                                          Opacity="0.9"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" 
                               VerticalAlignment="Center" 
                               Orientation="Horizontal" 
                               Spacing="8">
                        <Button Style="{StaticResource IconButton}"
                               Background="#FFFFFF20"
                               BorderThickness="0"
                               Click="BtnGenerarReporte_Click"
                               ToolTipService.ToolTip="Generar reporte">
                            <FontIcon Glyph="&#xE8A2;" Foreground="White" FontSize="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                               Background="#FFFFFF20"
                               BorderThickness="0"
                               ToolTipService.ToolTip="Exportar datos">
                            <FontIcon Glyph="&#xE896;" Foreground="White" FontSize="18"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estadísticas Mejoradas 
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                Total Recibos 
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource ReciboGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE8A1;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Recibos" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtTotalRecibos" 
                                          Text="0" 
                                          FontSize="28" 
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                Total Ingresos 
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource SuccessGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE74E;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Ingresos" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtTotalIngresos" 
                                          Text="RD$ 0.00" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="#11998e"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                 Total Egresos 
                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource DangerGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE738;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Egresos" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtTotalEgresos" 
                                          Text="RD$ 0.00" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="#eb3349"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Border>

                 Balance 
                <Border Grid.Column="6" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource PrimaryGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE8AB;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Balance Neto" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtBalance" 
                                          Text="RD$ 0.00" 
                                          FontSize="24" 
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>   -->

            <!-- Contenido Principal -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Panel Principal de Lista -->
                <Border Style="{StaticResource ModernCard}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Barra de Herramientas -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Búsqueda -->
                            <Border Grid.Column="0" 
                                   Background="{ThemeResource ControlFillColorDefaultBrush}"
                                   CornerRadius="8"
                                   Padding="12,0"
                                   Height="44"
                                   BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                   BorderThickness="1"
                                   Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE721;" 
                                             Grid.Column="0"
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             FontSize="16"
                                             Margin="0,0,8,0"/>

                                    <AutoSuggestBox x:Name="SearchBox"
                                                   Grid.Column="1"
                                                   PlaceholderText="Buscar recibos..."
                                                   TextChanged="SearchBox_TextChanged"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Botones de Acción -->
                            <StackPanel Grid.Column="1" 
                                       Orientation="Horizontal" 
                                       Spacing="8">
                                <Button Click="BtnNuevoRecibo_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="{StaticResource ReciboGradient}"
                                       Foreground="White"
                                       BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                                        <TextBlock Text="Nuevo" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnEditar"
                                       Click="BtnEditarRecibo_Click"
                                       Style="{StaticResource ModernButton}"
                                       IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                        <TextBlock Text="Editar" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnGenerarFacturaNcf"
                                       Click="BtnGenerarFacturaNcf_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="{StaticResource WarningGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8C7;" FontSize="14"/>
                                        <TextBlock Text="Factura NCF" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <!-- Botón Configurar Secuencia NCF (solo visible en modo Facturas) -->
                                <Button x:Name="btnConfigurarSecuenciaNcf"
                                       Click="BtnConfigurarSecuenciaNcf_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="#6B46C1"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Visibility="Collapsed"
                                       ToolTipService.ToolTip="Configurar secuencia automática de números NCF">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8B8;" FontSize="14"/>
                                        <TextBlock Text="Config. NCF" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnImprimir"
                                       Click="BtnImprimirRecibo_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="{StaticResource PrimaryGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE749;" FontSize="14"/>
                                        <TextBlock Text="Imprimir" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnEliminar"
                                       Click="BtnEliminarRecibo_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="{StaticResource DangerGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       IsEnabled="False">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Filtros -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                            <!-- Toggle para tipo de documento -->
                            <ToggleButton x:Name="TipoDocumentoToggle" 
                                         Click="TipoDocumento_Click"
                                         Height="44"
                                         MinWidth="180"
                                         CornerRadius="8"
                                         Background="{StaticResource ReciboGradient}"
                                         Foreground="White"
                                         BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon x:Name="TipoDocumentoIcon" Glyph="&#xE8A1;" FontSize="16"/>
                                    <TextBlock x:Name="TipoDocumentoText" Text="📄 Recibos" FontWeight="SemiBold"/>
                                </StackPanel>
                            </ToggleButton>
                            <ComboBox x:Name="TipoReciboCombo"
                                     Header="Filtro"
                                     MinWidth="140"
                                     SelectionChanged="TipoRecibo_SelectionChanged"
                                     CornerRadius="8">
                                <ComboBoxItem Content="📋 Todos" IsSelected="True"/>
                                <ComboBoxItem Content="📈 Ingreso"/>
                                <ComboBoxItem Content="📉 Egreso"/>
                            </ComboBox>
                            <ComboBox x:Name="OrdenarCombo"
                                     Header="Ordenar por"
                                     MinWidth="180"
                                     SelectionChanged="Ordenar_SelectionChanged"
                                     CornerRadius="8">
                                <ComboBoxItem Content="📅 Fecha (Reciente)" IsSelected="True"/>
                                <ComboBoxItem Content="📅 Fecha (Antigua)"/>
                                <ComboBoxItem Content="💰 Monto (Mayor)"/>
                                <ComboBoxItem Content="💰 Monto (Menor)"/>
                                <ComboBoxItem Content="🔢 Número de Recibo"/>
                            </ComboBox> 

                            <Border VerticalAlignment="Bottom" 
                                   Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                   CornerRadius="6"
                                   Padding="12,8"
                                   Margin="0,0,0,2">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="Total:"/>
                                    <Run x:Name="txtContador" Text="0" FontWeight="Bold"/>
                                    <Run x:Name="txtContadorTipo" Text="recibos"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Separador -->
                        <Border Grid.Row="2" 
                               Height="1" 
                               Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Margin="0,0,0,16"/>

                        <!-- Lista de Recibos -->
                        <Grid Grid.Row="3">
                            <ScrollViewer x:Name="ListViewScroller"
                                         VerticalScrollBarVisibility="Auto">
                                <ListView x:Name="RecibosListView"
                                         SelectionMode="Single"
                                         SelectionChanged="RecibosListView_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Recibo">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                   CornerRadius="10"
                                                   Padding="20,16"
                                                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                   BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Tipo -->
                                                    <Border Grid.Column="0"
                                                           Background="{x:Bind TipoReciboColor}"
                                                           CornerRadius="8"
                                                           Padding="10,6"
                                                           Margin="0,0,16,0"
                                                           VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="{x:Bind TipoReciboIcono}" FontSize="12"/>
                                                            <TextBlock Text="{x:Bind TipoRecibo}"
                                                                      FontSize="11"
                                                                      FontWeight="SemiBold"
                                                                      Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Número y Fecha -->
                                                    <StackPanel Grid.Column="1" 
                                                               VerticalAlignment="Center"
                                                               Spacing="4"
                                                               Margin="0,0,20,0"
                                                               MinWidth="120">
                                                        <TextBlock Text="{x:Bind NumeroRecibo}"
                                                                  FontFamily="Consolas"
                                                                  FontSize="15"
                                                                  FontWeight="Bold"
                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="{x:Bind FechaFormateada}" 
                                                                  FontSize="11"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- Información Principal -->
                                                    <StackPanel Grid.Column="2" 
                                                               VerticalAlignment="Center"
                                                               Spacing="6">
                                                        <TextBlock Text="{x:Bind RecibimosDe}" 
                                                                  FontSize="15"
                                                                  FontWeight="SemiBold"
                                                                  TextTrimming="CharacterEllipsis"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <TextBlock Grid.Column="0"
                                                                      Text="{x:Bind Concepto}" 
                                                                      FontSize="12"
                                                                      FontStyle="Italic"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      Margin="0,0,12,0"
                                                                      MaxWidth="300"/>
                                                            
                                                            <Border Grid.Column="1"
                                                                   Background="{x:Bind TipoPagoColor}"
                                                                   CornerRadius="6"
                                                                   Padding="8,4"
                                                                   Margin="0,0,8,0">
                                                                <TextBlock Text="{x:Bind TipoPago}"
                                                                          FontSize="10"
                                                                          FontWeight="SemiBold"
                                                                          Foreground="White"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="2"
                                                                      Text="{x:Bind DetallesPago}" 
                                                                      FontSize="11"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Monto 
                                                    <StackPanel Grid.Column="3" 
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               Margin="20,0,0,0">
                                                        <TextBlock FontSize="20" 
                                                                  FontWeight="Bold"
                                                                  TextAlignment="Right">
                                                            <Run Text="RD$ "/>
                                                            <Run Text="{x:Bind Monto}" Foreground="#11998e"/>
                                                        </TextBlock>
                                                    </StackPanel>-->
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>

                            <!-- Empty State -->
                            <StackPanel x:Name="EmptyState"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Spacing="24"
                                       Padding="40">
                                <Border Background="{StaticResource ReciboGradient}"
                                       Width="120" Height="120"
                                       CornerRadius="60"
                                       Opacity="0.1"/>
                                <FontIcon Glyph="&#xE8A1;" 
                                         FontSize="80"
                                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                         Margin="0,-140,0,60"/>
                                
                                <StackPanel Spacing="8">
                                    <TextBlock Text="No hay recibos registrados"
                                              FontSize="24"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Comienza creando tu primer recibo"
                                              HorizontalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <Button Click="BtnNuevoRecibo_Click"
                                       Background="{StaticResource ReciboGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Height="48"
                                       MinWidth="180"
                                       CornerRadius="8"
                                       FontSize="15"
                                       FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE710;" FontSize="18"/>
                                        <TextBlock Text="Crear Recibo"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Paginación -->
                        <Grid Grid.Row="4"
                             Margin="0,16,0,0"
                             Padding="0,12,0,0"
                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                             BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Info de Página -->
                            <StackPanel Grid.Column="0" 
                                       Orientation="Horizontal" 
                                       Spacing="8"
                                       VerticalAlignment="Center">
                                <Border Background="{StaticResource ReciboGradient}"
                                       CornerRadius="6"
                                       Padding="10,6">
                                    <TextBlock x:Name="txtPageInfo"
                                              Text="Página 1 de 1"
                                              FontSize="12"
                                              FontWeight="SemiBold"
                                              Foreground="White"/>
                                </Border>
                                
                                <Button Click="BtnActualizar_Click"
                                       Style="{StaticResource IconButton}"
                                       Background="{ThemeResource ControlFillColorDefaultBrush}"
                                       ToolTipService.ToolTip="Actualizar">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                </Button>
                            </StackPanel>

                            <!-- Botones de Navegación -->
                            <StackPanel Grid.Column="2" 
                                       Orientation="Horizontal" 
                                       Spacing="6"
                                       VerticalAlignment="Center">
                                <Button x:Name="btnFirstPage"
                                       Click="BtnFirstPage_Click"
                                       Style="{StaticResource IconButton}"
                                       IsEnabled="False"
                                       ToolTipService.ToolTip="Primera">
                                    <FontIcon Glyph="&#xE892;" FontSize="14"/>
                                </Button>

                                <Button x:Name="btnPreviousPage"
                                       Click="BtnPreviousPage_Click"
                                       IsEnabled="False"
                                       Width="70"
                                       Height="40"
                                       CornerRadius="8"
                                       ToolTipService.ToolTip="Anterior">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                                        <TextBlock Text="Ant" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Border Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                                       CornerRadius="8"
                                       Padding="14,10"
                                       MinWidth="50">
                                    <TextBlock Text="{x:Bind CurrentPage, Mode=OneWay}"
                                              FontSize="14"
                                              FontWeight="Bold"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"/>
                                </Border>

                                <Button x:Name="btnNextPage"
                                       Click="BtnNextPage_Click"
                                       IsEnabled="False"
                                       Width="70"
                                       Height="40"
                                       CornerRadius="8"
                                       ToolTipService.ToolTip="Siguiente">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Sig" FontSize="12" FontWeight="SemiBold"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnLastPage"
                                       Click="BtnLastPage_Click"
                                       Style="{StaticResource IconButton}"
                                       IsEnabled="False"
                                       ToolTipService.ToolTip="Última">
                                    <FontIcon Glyph="&#xE893;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Loading Indicator -->
        <Grid x:Name="LoadingOverlay"
             Background="#80000000"
             Visibility="Collapsed">
            <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                   CornerRadius="16"
                   Padding="40,32"
                   MaxWidth="400"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center">
                <StackPanel Spacing="20">
                    <ProgressRing x:Name="LoadingIndicator"
                                 IsActive="False"
                                 Width="60"
                                 Height="60"
                                 Foreground="{StaticResource ReciboGradient}"
                                 HorizontalAlignment="Center"/>
                    <TextBlock x:Name="LoadingText"
                              Text="Cargando recibos..."
                              FontSize="16"
                              FontWeight="SemiBold"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              TextWrapping="Wrap"/>
                    <TextBlock x:Name="LoadingSubtext"
                              Text="Por favor espere"
                              FontSize="13"
                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                              HorizontalAlignment="Center"
                              TextAlignment="Center"
                              Visibility="Collapsed"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Page>
