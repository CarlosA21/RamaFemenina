<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.ReciboPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:models="using:RamaFemenina.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Animaciones -->
        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="20" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Estilos -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="MinHeight" Value="140"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Gradiente para Recibos -->
        <LinearGradientBrush x:Key="ReciboGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#f093fb" Offset="0"/>
            <GradientStop Color="#f5576c" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid x:Name="MainContent" Margin="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="40,20,40,20">
            <Grid MaxWidth="1600" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header Premium -->
                <Border Grid.Row="0" 
                       CornerRadius="16" 
                       Padding="32,28"
                       Margin="0,0,0,24"
                       Background="{StaticResource ReciboGradient}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Viewbox Width="40" Height="40">
                                    <FontIcon Glyph="&#xE8A1;" Foreground="White"/>
                                </Viewbox>
                                <TextBlock Text="Gestión de Recibos"
                                          FontSize="32"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Administra y controla recibos de ingreso y egreso"
                                      FontSize="16"
                                      Foreground="#E3F2FD"
                                      Opacity="0.9"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" 
                                   VerticalAlignment="Center" 
                                   Orientation="Horizontal" 
                                   Spacing="12">
                            <Button Style="{StaticResource IconButton}"
                                   Background="#FFFFFF20"
                                   BorderThickness="0"
                                   Click="BtnGenerarReporte_Click"
                                   ToolTipService.ToolTip="Generar reporte">
                                <FontIcon Glyph="&#xE8A2;" Foreground="White" FontSize="20"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                   Background="#FFFFFF20"
                                   BorderThickness="0"
                                   ToolTipService.ToolTip="Exportar datos">
                                <FontIcon Glyph="&#xE896;" Foreground="White" FontSize="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Estadísticas -->
                <Grid Grid.Row="1" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Recibos -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource ReciboGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8A1;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtTotalRecibos" 
                                          Text="0" 
                                          FontSize="36" 
                                          FontWeight="Bold"/>
                                <TextBlock Text="Total Recibos" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74E;" FontSize="12" Foreground="#f5576c"/>
                                <TextBlock Text="+8 este mes" FontSize="12" Foreground="#f5576c"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Total Ingresos -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource SuccessGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE74E;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtTotalIngresos" 
                                          Text="RD$ 0.00" 
                                          FontSize="30" 
                                          FontWeight="Bold"
                                          Foreground="#11998e"/>
                                <TextBlock Text="Total Ingresos" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" Value="65" Foreground="#11998e" Height="4"/>
                        </Grid>
                    </Border>

                    <!-- Total Egresos -->
                    <Border Grid.Column="4" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource DangerGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE738;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtTotalEgresos" 
                                          Text="RD$ 0.00" 
                                          FontSize="30" 
                                          FontWeight="Bold"
                                          Foreground="#eb3349"/>
                                <TextBlock Text="Total Egresos" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" Value="35" Foreground="#eb3349" Height="4"/>
                        </Grid>
                    </Border>

                    <!-- Balance -->
                    <Border Grid.Column="6" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource PrimaryGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8AB;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtBalance" 
                                          Text="RD$ 0.00" 
                                          FontSize="30" 
                                          FontWeight="Bold"/>
                                <TextBlock Text="Balance Neto" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Border Grid.Row="2" 
                                   Background="{ThemeResource AccentAAFillColorTertiaryBrush}"
                                   CornerRadius="8"
                                   Padding="8,4">
                                <TextBlock Text="Ingresos - Egresos" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Toolbar con Búsqueda y Botones -->
                <Border Grid.Row="2" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Búsqueda -->
                        <Border Grid.Column="0" 
                               Background="{ThemeResource ControlFillColorDefaultBrush}"
                               CornerRadius="10"
                               Padding="16,0"
                               Height="52"
                               BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                               BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE721;" 
                                         Grid.Column="0"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                         FontSize="20"
                                         Margin="0,0,12,0"/>

                                <AutoSuggestBox x:Name="SearchBox"
                                               Grid.Column="1"
                                               PlaceholderText="Buscar por número, nombre, concepto, cédula, monto..."
                                               TextChanged="SearchBox_TextChanged"
                                               Background="Transparent"
                                               BorderThickness="0"
                                               VerticalAlignment="Center"/>
                            </Grid>
                        </Border>

                        <!-- Botones -->
                        <StackPanel Grid.Column="1" 
                                   Orientation="Horizontal" 
                                   Spacing="12" 
                                   Margin="20,0,0,0">
                            <Button Click="BtnNuevoRecibo_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="{StaticResource ReciboGradient}"
                                   Foreground="White"
                                   BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE710;" FontSize="18"/>
                                    <TextBlock Text="Nuevo Recibo" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnEditar"
                                   Click="BtnEditarRecibo_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="{ThemeResource SystemFillColorAttentionBrush}"
                                   IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE70F;" FontSize="16"/>
                                    <TextBlock Text="Editar" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnEliminar"
                                   Click="BtnEliminarRecibo_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="{StaticResource DangerGradient}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE74D;" FontSize="16"/>
                                    <TextBlock Text="Eliminar" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnImprimir"
                                   Click="BtnImprimirRecibo_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="{StaticResource PrimaryGradient}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   IsEnabled="False">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE749;" FontSize="16"/>
                                    <TextBlock Text="Imprimir" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Filtros -->
                <Border Grid.Row="3" 
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       CornerRadius="12"
                       Padding="20"
                       Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="16">
                        <ComboBox x:Name="TipoReciboCombo"
                                 Header="Tipo de Recibo"
                                 MinWidth="160"
                                 SelectionChanged="TipoRecibo_SelectionChanged"
                                 CornerRadius="8">
                            <ComboBoxItem Content="📋 Todos" IsSelected="True"/>
                            <ComboBoxItem Content="📈 Ingreso"/>
                            <ComboBoxItem Content="📉 Egreso"/>
                        </ComboBox>

                        <ComboBox x:Name="OrdenarCombo"
                                 Header="Ordenar por"
                                 MinWidth="200"
                                 SelectionChanged="Ordenar_SelectionChanged"
                                 CornerRadius="8">
                            <ComboBoxItem Content="📅 Fecha (Reciente)" IsSelected="True"/>
                            <ComboBoxItem Content="📅 Fecha (Antigua)"/>
                            <ComboBoxItem Content="💰 Monto (Mayor)"/>
                            <ComboBoxItem Content="💰 Monto (Menor)"/>
                            <ComboBoxItem Content="🔢 Número de Recibo"/>
                        </ComboBox>
                    </StackPanel>
                </Border>

                <!-- Tabs -->
                <Border Grid.Row="4" 
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       CornerRadius="12"
                       Padding="8"
                       Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <ToggleButton Content="🧾 Lista" IsChecked="True" MinWidth="100" Height="40" CornerRadius="8"/>
                            <ToggleButton Content="📊 Resumen" MinWidth="120" Height="40" CornerRadius="8"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" 
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                            <Run Text="Total:"/>
                            <Run x:Name="txtContador" Text="0" FontWeight="Bold"/>
                            <Run Text="recibos"/>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Lista Premium -->
                <Border Grid.Row="5" Style="{StaticResource ModernCard}" MinHeight="400">
                    <Grid>
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                     VerticalScrollBarVisibility="Auto"
                                     x:Name="ListViewScroller"
                                     Visibility="Visible">
                            <ListView x:Name="RecibosListView"
                                     SelectionMode="Single"
                                     SelectionChanged="RecibosListView_SelectionChanged"
                                     CornerRadius="8">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                               CornerRadius="8,8,0,0"
                                               Padding="20,16"
                                               MinWidth="1600">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="TIPO" Grid.Column="0" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="N° RECIBO" Grid.Column="1" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="FECHA" Grid.Column="2" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="NOMBRE/RAZÓN SOCIAL" Grid.Column="3" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="CÉDULA" Grid.Column="4" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="MONTO (RD$)" Grid.Column="5" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="CONCEPTO" Grid.Column="6" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="TIPO PAGO" Grid.Column="7" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="DETALLES" Grid.Column="8" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>

                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="models:Recibo">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                               CornerRadius="8"
                                               Padding="20,16"
                                               Margin="0,1"
                                               MinWidth="1600"
                                               BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                               BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="100"/>
                                                    <ColumnDefinition Width="120"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="180"/>
                                                    <ColumnDefinition Width="240"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="200"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                       Background="{x:Bind TipoReciboColor}"
                                                       CornerRadius="16"
                                                       Padding="12,6"
                                                       HorizontalAlignment="Center"
                                                       VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="{x:Bind TipoReciboIcono}"
                                                                  FontSize="12"/>
                                                        <TextBlock Text="{x:Bind TipoRecibo}"
                                                                  FontSize="11"
                                                                  FontWeight="Bold"
                                                                  Foreground="White"/>
                                                    </StackPanel>
                                                </Border>

                                                <Border Grid.Column="1"
                                                       Background="{ThemeResource SystemFillColorSolidNeutralBrush}"
                                                       CornerRadius="8"
                                                       Padding="12,8"
                                                       VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind NumeroRecibo}"
                                                              FontFamily="Consolas"
                                                              FontSize="13"
                                                              FontWeight="Bold"
                                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                                              TextAlignment="Center"/>
                                                </Border>

                                                <TextBlock Text="{x:Bind FechaFormateada}" 
                                                          Grid.Column="2"
                                                          VerticalAlignment="Center"
                                                          FontSize="13"/>

                                                <TextBlock Text="{x:Bind RecibimosDe}" 
                                                          Grid.Column="3"
                                                          VerticalAlignment="Center"
                                                          FontSize="14"
                                                          FontWeight="SemiBold"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <TextBlock Text="{x:Bind Cedula}" 
                                                          Grid.Column="4"
                                                          VerticalAlignment="Center"
                                                          FontFamily="Consolas"
                                                          FontSize="12"/>

                                                <TextBlock Grid.Column="5" VerticalAlignment="Center" FontSize="15" FontWeight="Bold">
                                                    <Run Text="RD$ "/>
                                                    <Run Text="{x:Bind Monto}" Foreground="#11998e"/>
                                                </TextBlock>

                                                <TextBlock Text="{x:Bind Concepto}" 
                                                          Grid.Column="6"
                                                          VerticalAlignment="Center"
                                                          FontSize="12"
                                                          FontStyle="Italic"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <Border Grid.Column="7"
                                                       Background="{x:Bind TipoPagoColor}"
                                                       CornerRadius="12"
                                                       Padding="12,6"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind TipoPago}"
                                                              FontSize="11"
                                                              FontWeight="SemiBold"
                                                              Foreground="White"/>
                                                </Border>

                                                <TextBlock Text="{x:Bind DetallesPago}" 
                                                          Grid.Column="8"
                                                          VerticalAlignment="Center"
                                                          FontSize="11"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          TextTrimming="CharacterEllipsis"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>

                        <!-- Empty State -->
                        <StackPanel x:Name="EmptyState"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Spacing="32"
                                   Padding="40">
                            <Viewbox Width="200" Height="200">
                                <Grid>
                                    <Ellipse Fill="{StaticResource ReciboGradient}" Opacity="0.1"/>
                                    <FontIcon Glyph="&#xE8A1;" 
                                             Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                             FontSize="120"/>
                                </Grid>
                            </Viewbox>
                            
                            <StackPanel Spacing="12">
                                <TextBlock Text="No hay recibos registrados"
                                          FontSize="28"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Comienza registrando el primer recibo de ingreso o egreso"
                                          HorizontalAlignment="Center"
                                          TextAlignment="Center"
                                          MaxWidth="500"
                                          TextWrapping="Wrap"
                                          FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Button Click="BtnNuevoRecibo_Click"
                                   Background="{StaticResource ReciboGradient}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Height="56"
                                   MinWidth="220"
                                   CornerRadius="12"
                                   FontSize="16"
                                   FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE710;" FontSize="20"/>
                                    <TextBlock Text="Crear Primer Recibo"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
