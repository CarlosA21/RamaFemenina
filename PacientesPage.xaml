<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.PacientesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:models="using:RamaFemenina.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Padding="24,24,24,16">
            <TextBlock 
                Text="Gestión de Pacientes"
                Style="{StaticResource TitleTextBlockStyle}"
                Margin="0,0,0,8"/>
            <TextBlock 
                Text="Administra la información de los pacientes"
                Style="{StaticResource BodyTextBlockStyle}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        </StackPanel>

        <!-- Content -->
        <Grid Grid.Row="1" Padding="24,0,24,24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Toolbar -->
            <CommandBar Grid.Row="0" DefaultLabelPosition="Right" Background="Transparent">
                <AppBarButton 
                    Icon="Add" 
                    Label="Nuevo Paciente"
                    Click="BtnNuevoPaciente_Click"/>
                <AppBarButton 
                    Icon="Edit" 
                    Label="Editar"
                    Click="BtnEditarPaciente_Click"
                    IsEnabled="{x:Bind IsPatientSelected, Mode=OneWay}"/>
                <AppBarButton 
                    Icon="Delete" 
                    Label="Eliminar"
                    Click="BtnEliminarPaciente_Click"
                    IsEnabled="{x:Bind IsPatientSelected, Mode=OneWay}"/>
                <!--  Donaciones  -->
                <AppBarButton 
                    Icon="Calculator" 
                    Label="Registrar Donación"
                    Click="BtnRegistrarDonacion_Click"
                    IsEnabled="{x:Bind IsPatientSelected, Mode=OneWay}"/>
            </CommandBar>

            <!-- Search Bar -->
            <AutoSuggestBox
                x:Name="SearchBox"
                Grid.Row="1"
                PlaceholderText="Buscar por nombre, cédula, teléfono, área..."
                QueryIcon="Find"
                Margin="0,8,0,8"
                TextChanged="SearchBox_TextChanged"/>

            <!-- DataGrid / ListView -->
            <Grid Grid.Row="2" Margin="0,8,0,0">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <ListView
                        x:Name="PacientesListView"
                        SelectionMode="Single"
                        SelectionChanged="PacientesListView_SelectionChanged">
                        <ListView.Header>
                            <Grid Padding="12,8" Background="{ThemeResource CardBackgroundFillColorDefaultBrush}" MinWidth="1200">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="250"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="120"/>
                                    <ColumnDefinition Width="80"/>
                                    <ColumnDefinition Width="100"/>
                                    <ColumnDefinition Width="*" MinWidth="150"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Cédula" FontWeight="SemiBold" Grid.Column="0"/>
                                <TextBlock Text="Nombre Completo" FontWeight="SemiBold" Grid.Column="1"/>
                                <TextBlock Text="Teléfono" FontWeight="SemiBold" Grid.Column="2"/>
                                <TextBlock Text="Celular" FontWeight="SemiBold" Grid.Column="3"/>
                                <TextBlock Text="N° Registro" FontWeight="SemiBold" Grid.Column="4"/>
                                <TextBlock Text="Sexo" FontWeight="SemiBold" Grid.Column="5"/>
                                <TextBlock Text="Área" FontWeight="SemiBold" Grid.Column="6"/>
                                <TextBlock Text="Observaciones" FontWeight="SemiBold" Grid.Column="7"/>
                            </Grid>
                        </ListView.Header>
                        
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="models:Paciente">
                                <Grid Padding="12,8" MinWidth="1200">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="250"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*" MinWidth="150"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{x:Bind cedula}" Grid.Column="0"/>
                                    <TextBlock Text="{x:Bind nombre}" Grid.Column="1" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind telefono}" Grid.Column="2"/>
                                    <TextBlock Text="{x:Bind celular}" Grid.Column="3"/>
                                    <TextBlock Text="{x:Bind nrecord}" Grid.Column="4"/>
                                    <TextBlock Text="{x:Bind sexo}" Grid.Column="5"/>
                                    <TextBlock Text="{x:Bind area}" Grid.Column="6" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{x:Bind observaciones}" Grid.Column="7" TextTrimming="CharacterEllipsis"/>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </ScrollViewer>

                <!-- Empty State -->
                <StackPanel 
                    x:Name="EmptyState"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="16">
                    <TextBlock 
                        Text="👥"
                        FontSize="72"
                        HorizontalAlignment="Center"/>
                    <TextBlock 
                        Text="No hay pacientes registrados"
                        FontSize="20"
                        FontWeight="SemiBold"
                        HorizontalAlignment="Center"/>
                    <TextBlock 
                        Text="Haz clic en 'Nuevo Paciente' para comenzar"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</Page>
