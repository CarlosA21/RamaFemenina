<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.PacientesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:models="using:RamaFemenina.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Animaciones -->
        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="20" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Estilos -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="120"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Gradientes -->
        <LinearGradientBrush x:Key="PacientesGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4facfe" Offset="0"/>
            <GradientStop Color="#00f2fe" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11998e" Offset="0"/>
            <GradientStop Color="#38ef7d" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#eb3349" Offset="0"/>
            <GradientStop Color="#f45c43" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#f2994a" Offset="0"/>
            <GradientStop Color="#f2c94c" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid x:Name="MainContent">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>

        <Grid Padding="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Mejorado -->
            <Border Grid.Row="0" 
                   CornerRadius="16" 
                   Padding="32,24"
                   Margin="0,0,0,20"
                   Background="{StaticResource PacientesGradient}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="#FFFFFF30" 
                                   Width="48" Height="48" 
                                   CornerRadius="12"
                                   Padding="10">
                                <FontIcon Glyph="&#xE77B;" Foreground="White" FontSize="24"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Gestión de Pacientes"
                                          FontSize="28"
                                          FontWeight="Bold"
                                          Foreground="White"/>
                                <TextBlock Text="Administra y monitorea todos los pacientes registrados"
                                          FontSize="14"
                                          Foreground="#E8EAED"
                                          Opacity="0.9"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" 
                               VerticalAlignment="Center" 
                               Orientation="Horizontal" 
                               Spacing="8">
                        <Button Style="{StaticResource IconButton}"
                               Background="#FFFFFF20"
                               BorderThickness="0"
                               Click="BtnActualizar_Click"
                               ToolTipService.ToolTip="Actualizar datos">
                            <FontIcon Glyph="&#xE72C;" Foreground="White" FontSize="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                               Background="#FFFFFF20"
                               BorderThickness="0"
                               ToolTipService.ToolTip="Exportar datos">
                            <FontIcon Glyph="&#xE896;" Foreground="White" FontSize="18"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estadísticas Mejoradas 
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                 Total Pacientes 
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource PacientesGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE716;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Pacientes" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtTotalPacientes" 
                                          Text="0" 
                                          FontSize="28" 
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                Activos 
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource SuccessGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE8FB;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Pacientes Activos" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtPacientesActivos" 
                                          Text="0" 
                                          FontSize="28" 
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                 Áreas
                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource PrimaryGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE8F4;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Áreas Activas" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtPorArea" 
                                          Text="0" 
                                          FontSize="28" 
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                Nuevos este mes 
                <Border Grid.Column="6" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource WarningGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE787;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Nuevos Este Mes" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtUltimoMes" 
                                          Text="N/A" 
                                          FontSize="28" 
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>-->

            <!-- Contenido Principal -->
            <Grid Grid.Row="2">
                <!-- Panel Principal de Lista -->
                <Border Style="{StaticResource ModernCard}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Barra de Herramientas -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Búsqueda -->
                            <Border Grid.Column="0" 
                                   Background="{ThemeResource ControlFillColorDefaultBrush}"
                                   CornerRadius="8"
                                   Padding="12,0"
                                   Height="44"
                                   BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                   BorderThickness="1"
                                   Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE721;" 
                                             Grid.Column="0"
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             FontSize="16"
                                             Margin="0,0,8,0"/>

                                    <AutoSuggestBox x:Name="SearchBox"
                                                   Grid.Column="1"
                                                   PlaceholderText="Buscar pacientes..."
                                                   TextChanged="SearchBox_TextChanged"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Botones de Acción -->
                            <StackPanel Grid.Column="1" 
                                       Orientation="Horizontal" 
                                       Spacing="8">
                                <Button Click="BtnNuevoPaciente_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="{StaticResource PacientesGradient}"
                                       Foreground="White"
                                       BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                                        <TextBlock Text="Nuevo" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnDonacion"
                                       Click="BtnRegistrarDonacion_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="{StaticResource SuccessGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE8EC;" FontSize="14"/>
                                        <TextBlock Text="Donación" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Filtros -->
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                            <Border VerticalAlignment="Bottom" 
                                   Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                   CornerRadius="6"
                                   Padding="12,8"
                                   Margin="0,0,0,2">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="Total:"/>
                                    <Run x:Name="txtContador" Text="0" FontWeight="Bold"/>
                                    <Run Text="pacientes"/>
                                </TextBlock>
                            </Border>
                        </StackPanel>

                        <!-- Separador -->
                        <Border Grid.Row="2" 
                               Height="1" 
                               Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Margin="0,0,0,16"/>

                        <!-- Lista de Pacientes -->
                        <Grid Grid.Row="3">
                            <ScrollViewer x:Name="ListViewScroller"
                                         VerticalScrollBarVisibility="Auto">
                                <ListView x:Name="PacientesListView"
                                         SelectionMode="Single"
                                         SelectionChanged="PacientesListView_SelectionChanged">
                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Paciente">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                   CornerRadius="10"
                                                   Padding="20,16"
                                                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                   BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- Badge ID -->
                                                    <Border Grid.Column="0"
                                                           Background="{StaticResource PacientesGradient}"
                                                           CornerRadius="8"
                                                           Padding="10,6"
                                                           Margin="0,0,16,0"
                                                           VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Bind idpaciente}"
                                                                  FontSize="11"
                                                                  FontWeight="SemiBold"
                                                                  Foreground="White"/>
                                                    </Border>

                                                    <!-- Cédula y Info -->
                                                    <StackPanel Grid.Column="1" 
                                                               VerticalAlignment="Center"
                                                               Spacing="4"
                                                               Margin="0,0,20,0"
                                                               MinWidth="120">
                                                        <TextBlock Text="{x:Bind cedula}"
                                                                  FontFamily="Consolas"
                                                                  FontSize="15"
                                                                  FontWeight="Bold"
                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="{x:Bind sexo}" 
                                                                  FontSize="11"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- Información Principal -->
                                                    <StackPanel Grid.Column="2" 
                                                               VerticalAlignment="Center"
                                                               Spacing="6">
                                                        <TextBlock Text="{x:Bind nombre}" 
                                                                  FontSize="15"
                                                                  FontWeight="SemiBold"
                                                                  TextTrimming="CharacterEllipsis"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>
                                                            
                                                            <Border Grid.Column="0"
                                                                   Background="{ThemeResource SystemFillColorSolidNeutralBrush}"
                                                                   CornerRadius="6"
                                                                   Padding="8,4"
                                                                   Margin="0,0,8,0">
                                                                <TextBlock Text="{x:Bind area}"
                                                                          FontSize="10"
                                                                          FontWeight="SemiBold"/>
                                                            </Border>

                                                            <TextBlock Grid.Column="1"
                                                                      Text="{x:Bind telefono}" 
                                                                      FontSize="11"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      VerticalAlignment="Center"
                                                                      Margin="0,0,8,0"/>
                                                            
                                                            <TextBlock Grid.Column="2"
                                                                      Text="{x:Bind celular}" 
                                                                      FontSize="11"
                                                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                      TextTrimming="CharacterEllipsis"
                                                                      VerticalAlignment="Center"/>
                                                        </Grid>
                                                    </StackPanel>

                                                    <!-- Botones de Acción -->
                                                    <StackPanel Grid.Column="3" 
                                                               Orientation="Horizontal" 
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="20,0,0,0"
                                                               Spacing="6">
                                                        <Button Click="BtnVerDonaciones_Click"
                                                               Tag="{x:Bind idpaciente}"
                                                               Style="{StaticResource IconButton}"
                                                               Background="{StaticResource PrimaryGradient}"
                                                               BorderThickness="0"
                                                               ToolTipService.ToolTip="Ver Donaciones">
                                                            <FontIcon Glyph="&#xE8EC;" FontSize="14" Foreground="White"/>
                                                        </Button>
                                                        
                                                        <Button Click="BtnEditarPaciente_Click"
                                                               Tag="{x:Bind idpaciente}"
                                                               Style="{StaticResource IconButton}"
                                                               ToolTipService.ToolTip="Editar">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                                        </Button>
                                                        
                                                        <Button Click="BtnEliminarPaciente_Click"
                                                               Tag="{x:Bind idpaciente}"
                                                               Style="{StaticResource IconButton}"
                                                               Background="{StaticResource DangerGradient}"
                                                               BorderThickness="0"
                                                               ToolTipService.ToolTip="Eliminar">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="14" Foreground="White"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>

                            <!-- Empty State -->
                            <StackPanel x:Name="EmptyState"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Spacing="24"
                                       Padding="40">
                                <Border Background="{StaticResource PacientesGradient}"
                                       Width="120" Height="120"
                                       CornerRadius="60"
                                       Opacity="0.1"/>
                                <FontIcon Glyph="&#xE77B;" 
                                         FontSize="80"
                                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                         Margin="0,-140,0,60"/>
                                
                                <StackPanel Spacing="8">
                                    <TextBlock Text="No hay pacientes registrados"
                                              FontSize="24"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Comienza registrando el primer paciente"
                                              HorizontalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <Button Click="BtnNuevoPaciente_Click"
                                       Background="{StaticResource PacientesGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Height="48"
                                       MinWidth="180"
                                       CornerRadius="8"
                                       FontSize="15"
                                       FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE710;" FontSize="18"/>
                                        <TextBlock Text="Crear Paciente"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Paginación -->
                        <Grid Grid.Row="4"
                             Margin="0,16,0,0"
                             Padding="0,12,0,0"
                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                             BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Info de Página -->
                            <StackPanel Grid.Column="0" 
                                       Orientation="Horizontal" 
                                       Spacing="8"
                                       VerticalAlignment="Center">
                                <Border Background="{StaticResource PacientesGradient}"
                                       CornerRadius="6"
                                       Padding="10,6">
                                    <TextBlock x:Name="txtPageInfo"
                                              Text="{x:Bind PageInfo, Mode=OneWay}"
                                              FontSize="12"
                                              FontWeight="SemiBold"
                                              Foreground="White"/>
                                </Border>
                            </StackPanel>

                            <!-- Botones de Navegación -->
                            <StackPanel Grid.Column="2" 
                                       Orientation="Horizontal" 
                                       Spacing="6"
                                       VerticalAlignment="Center">
                                <Button x:Name="btnFirstPage"
                                       Click="BtnFirstPage_Click"
                                       Style="{StaticResource IconButton}"
                                       IsEnabled="{x:Bind HasPreviousPage, Mode=OneWay}"
                                       ToolTipService.ToolTip="Primera">
                                    <FontIcon Glyph="&#xE892;" FontSize="14"/>
                                </Button>

                                <Button x:Name="btnPreviousPage"
                                       Click="BtnPreviousPage_Click"
                                       IsEnabled="{x:Bind HasPreviousPage, Mode=OneWay}"
                                       Width="70"
                                       Height="40"
                                       CornerRadius="8"
                                       ToolTipService.ToolTip="Anterior">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                                        <TextBlock Text="Ant" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Border Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                                       CornerRadius="8"
                                       Padding="14,10"
                                       MinWidth="50">
                                    <TextBlock Text="{x:Bind CurrentPage, Mode=OneWay}"
                                              FontSize="14"
                                              FontWeight="Bold"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"/>
                                </Border>

                                <Button x:Name="btnNextPage"
                                       Click="BtnNextPage_Click"
                                       IsEnabled="{x:Bind HasNextPage, Mode=OneWay}"
                                       Width="70"
                                       Height="40"
                                       CornerRadius="8"
                                       ToolTipService.ToolTip="Siguiente">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Sig" FontSize="12" FontWeight="SemiBold"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnLastPage"
                                       Click="BtnLastPage_Click"
                                       Style="{StaticResource IconButton}"
                                       IsEnabled="{x:Bind HasNextPage, Mode=OneWay}"
                                       ToolTipService.ToolTip="Última">
                                    <FontIcon Glyph="&#xE893;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Loading Indicator -->
        <Grid x:Name="LoadingOverlay"
             Background="#80000000"
             Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Spacing="16">
                <ProgressRing x:Name="LoadingIndicator"
                             Width="60"
                             Height="60"
                             Foreground="White"/>
                <TextBlock Text="Cargando pacientes..."
                          Foreground="White"
                          FontSize="16"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
