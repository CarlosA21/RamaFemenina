                    </Grid>
                </Border>
            </Grid> -->

            <!-- Contenido Principal -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Panel Principal de Lista -->
                <Border Style="{StaticResource ModernCard}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Barra de Herramientas -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Búsqueda -->
                            <Border Grid.Column="0" 
                                   Background="{ThemeResource ControlFillColorDefaultBrush}"
                                   CornerRadius="8"
                                   Padding="12,0"
                                   Height="44"
                                   BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                   BorderThickness="1"
                                   Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE721;" 
                                             Grid.Column="0"
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             FontSize="16"
                                             Margin="0,0,8,0"/>

                                    <TextBox x:Name="txtBuscar"
                                            Grid.Column="1"
                                            PlaceholderText="Buscar clientes..."
                                            TextChanged="TxtBuscar_TextChanged"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Botones de Acción -->
                            <StackPanel Grid.Column="1" 
                                       Orientation="Horizontal" 
                                       Spacing="8">
                                <Button x:Name="btnNuevo"
                                       Click="BtnNuevo_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="{StaticResource ClienteGradient}"
                                       Foreground="White"
                                       BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                                        <TextBlock Text="Nuevo" FontSize="13"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Filtros 
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                            <ComboBox Header="Ordenar por"
                                     MinWidth="180"
                                     CornerRadius="8">
                                <ComboBoxItem Content="📅 Nombre A-Z" IsSelected="True"/>
                                <ComboBoxItem Content="📅 Nombre Z-A"/>
                                <ComboBoxItem Content="🏢 Con RNC"/>
                                <ComboBoxItem Content="📞 Con Teléfono"/>
                            </ComboBox>

                            <Border VerticalAlignment="Bottom" 
                                   Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                   CornerRadius="6"
                                   Padding="12,8"
                                   Margin="0,0,0,2">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="Total:"/>
                                    <Run x:Name="txtContador" Text="0" FontWeight="Bold"/>
                                    <Run Text="clientes"/>
                                </TextBlock>
                            </Border>
                        </StackPanel> -->

                        <!-- Separador -->
                        <Border Grid.Row="2" 
                               Height="1" 
                               Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Margin="0,0,0,16"/>

                        <!-- Lista de Clientes -->
                        <Grid Grid.Row="3">
                            <ScrollViewer x:Name="ListViewScroller"
                                         VerticalScrollBarVisibility="Auto">
                                <ListView x:Name="lvClientes"
                                         SelectionMode="Single"
                                         IsItemClickEnabled="True"
                                         ItemClick="LvClientes_ItemClick">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="12"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="local:ClienteViewModel">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                   CornerRadius="10"
                                                   Padding="20,16"
                                                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                   BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ID Cliente -->
                                                    <Border Grid.Column="0"
                                                           Background="{StaticResource ClienteGradient}"
                                                           CornerRadius="8"
                                                           Padding="10,6"
                                                           Margin="0,0,16,0"
                                                           VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="🏢" FontSize="12"/>
                                                            <TextBlock Text="{x:Bind IdCliente}"
                                                                      FontSize="11"
                                                                      FontWeight="SemiBold"
                                                                      Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- RNC y Teléfono -->
                                                    <StackPanel Grid.Column="1" 
                                                               VerticalAlignment="Center"
                                                               Spacing="4"
                                                               Margin="0,0,20,0"
                                                               MinWidth="140">
                                                        <TextBlock Text="{x:Bind RncDisplay}"
                                                                  FontFamily="Consolas"
                                                                  FontSize="12"
                                                                  FontWeight="Bold"
                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="{x:Bind TelefonoDisplay}" 
                                                                  FontSize="11"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- Información Principal -->
                                                    <StackPanel Grid.Column="2" 
                                                               VerticalAlignment="Center"
                                                               Spacing="6">
                                                        <TextBlock Text="{x:Bind Nombre}" 
                                                                  FontSize="15"
                                                                  FontWeight="SemiBold"
                                                                  TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{x:Bind DireccionDisplay}" 
                                                                  FontSize="12"
                                                                  FontStyle="Italic"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  TextTrimming="CharacterEllipsis"
                                                                  MaxWidth="400"/>
                                                    </StackPanel>

                                                    <!-- Botones de Acción -->
                                                    <StackPanel Grid.Column="3" 
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               Orientation="Horizontal"
                                                               Spacing="8"
                                                               Margin="20,0,0,0">
                                                        <Button Click="BtnEditar_Click"
                                                               Tag="{x:Bind IdCliente}"
                                                               Background="{ThemeResource SystemFillColorAttentionBrush}"
                                                               CornerRadius="6"
                                                               Padding="10,6"
                                                               ToolTipService.ToolTip="Editar">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                                                        </Button>
                                                        
                                                        <Button Click="BtnEliminar_Click"
                                                               Tag="{x:Bind IdCliente}"
                                                               Background="{StaticResource DangerGradient}"
                                                               Foreground="White"
                                                               BorderThickness="0"
                                                               CornerRadius="6"
                                                               Padding="10,6"
                                                               ToolTipService.ToolTip="Eliminar">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>

                            <!-- Empty State -->
                            <StackPanel x:Name="emptyState"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Spacing="24"
                                       Padding="40">
                                <Border Background="{StaticResource ClienteGradient}"
                                       Width="120" Height="120"
                                       CornerRadius="60"
                                       Opacity="0.1"/>
                                <FontIcon Glyph="&#xE8D4;" 
                                         FontSize="80"
                                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                         Margin="0,-140,0,60"/>
                                
                                <StackPanel Spacing="8">
                                    <TextBlock Text="No hay clientes registrados"
                                              FontSize="24"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Comienza agregando tu primer cliente"
                                              HorizontalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <Button Click="BtnNuevo_Click"
                                       Background="{StaticResource ClienteGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Height="48"
                                       MinWidth="180"
                                       CornerRadius="8"
                                       FontSize="15"
                                       FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE710;" FontSize="18"/>
                                        <TextBlock Text="Agregar Cliente"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Paginación -->
                        <Grid Grid.Row="4"
                             Margin="0,16,0,0"
                             Padding="0,12,0,0"
                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                             BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Info de Página -->
                            <StackPanel Grid.Column="0" 
                                       Orientation="Horizontal" 
                                       Spacing="8"
                                       VerticalAlignment="Center">
                                <Border Background="{StaticResource ClienteGradient}"
                                       CornerRadius="6"
                                       Padding="10,6">
                                    <TextBlock x:Name="txtPageInfo"
                                              Text="Página 1 de 1"
                                              FontSize="12"
                                              FontWeight="SemiBold"
                                              Foreground="White"/>
                                </Border>
                                
                                <Button Click="BtnActualizar_Click"
                                       Style="{StaticResource IconButton}"
                                       Background="{ThemeResource ControlFillColorDefaultBrush}"
                                       ToolTipService.ToolTip="Actualizar">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                </Button>
                            </StackPanel>

                            <!-- Botones de Navegación -->
                            <StackPanel Grid.Column="2" 
                                       Orientation="Horizontal" 
                                       Spacing="6"
                                       VerticalAlignment="Center">
                                <Button x:Name="btnFirstPage"
                                       Click="BtnFirstPage_Click"
                                       Style="{StaticResource IconButton}"
                                       IsEnabled="False"
                                       ToolTipService.ToolTip="Primera">
                                    <FontIcon Glyph="&#xE892;" FontSize="14"/>
                                </Button>

                                <Button x:Name="btnPreviousPage"
                                       Click="BtnPreviousPage_Click"
                                       IsEnabled="False"
                                       Width="70"
                                       Height="40"
                                       CornerRadius="8"
                                       ToolTipService.ToolTip="Anterior">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                                        <TextBlock Text="Ant" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Border Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                                       CornerRadius="8"
                                       Padding="14,10"
                                       MinWidth="50">
                                    <TextBlock Text="1"
                                              FontSize="14"
                                              FontWeight="Bold"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"/>
                                </Border>

                                <Button x:Name="btnNextPage"
                                       Click="BtnNextPage_Click"
                                       IsEnabled="False"
                                       Width="70"
                                       Height="40"
                                       CornerRadius="8"
                                       ToolTipService.ToolTip="Siguiente">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Sig" FontSize="12" FontWeight="SemiBold"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnLastPage"
                                       Click="BtnLastPage_Click"
                                       Style="{StaticResource IconButton}"
                                       IsEnabled="False"
                                       ToolTipService.ToolTip="Última">
                                    <FontIcon Glyph="&#xE893;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Modal Dialog para Add/Edit -->
        <Grid x:Name="modalOverlay" 
              Visibility="Collapsed"
              Background="#DD000000">
            <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                   CornerRadius="16"
                   MaxWidth="700"
                   Margin="40"
                   VerticalAlignment="Center"
                   Padding="32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                
                <StackPanel Spacing="20">
                    <!-- Dialog Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource ClienteGradient}"
                                   Width="48" Height="48"
                                   CornerRadius="12">
                                <FontIcon Glyph="&#xE8D4;" Foreground="White" FontSize="24"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtModalTitle" 
                                          Text="Nuevo Cliente"
                                          FontSize="24"
                                          FontWeight="Bold"/>
                                <TextBlock Text="Complete la información del cliente" 
                                          FontSize="13"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Button Click="BtnCerrarModal_Click"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Style="{StaticResource IconButton}"
                               Width="40" Height="40"
                               Background="Transparent">
                            <FontIcon Glyph="&#xE711;" FontSize="16"/>
                        </Button>
                    </Grid>

                    <!-- Form Fields -->
                    <StackPanel Spacing="16">
                        <TextBox x:Name="txtNombre"
                                Header="Nombre / Razón Social *"
                                PlaceholderText="Ingrese el nombre o razón social"
                                MaxLength="200"
                                CornerRadius="8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="txtRnc"
                                    Grid.Column="0"
                                    Header="RNC / Cédula"
                                    PlaceholderText="130-12345-6"
                                    MaxLength="20"
                                    CornerRadius="8"/>
                            
                            <TextBox x:Name="txtTelefono"
                                    Grid.Column="2"
                                    Header="Teléfono Principal"
                                    PlaceholderText="809-123-4567"
                                    MaxLength="20"
                                    CornerRadius="8"/>
                        </Grid>

                        <TextBox x:Name="txtDireccion"
                                Header="Dirección Comercial"
                                PlaceholderText="Calle, número, sector, ciudad, provincia"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="90"
                                MaxLength="500"
                                CornerRadius="8"/>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnGuardar"
                               Grid.Column="0"
                               Click="BtnGuardar_Click"
                               Background="{StaticResource ClienteGradient}"
                               Foreground="White"
                               BorderThickness="0"
                               Height="52"
                               CornerRadius="10"
                               HorizontalAlignment="Stretch"
                               FontSize="15"
                               FontWeight="SemiBold">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <FontIcon Glyph="&#xE74E;" FontSize="18"/>
                                <TextBlock Text="Guardar Cliente"/>
