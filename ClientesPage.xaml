                                          Text="0" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="#4facfe"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                 Nuevos 
                <Border Grid.Column="6" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>
                        
                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource WarningGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE710;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Nuevos Hoy" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtNuevos" 
                                          Text="0" 
                                          FontSize="24" 
                                          FontWeight="Bold"
