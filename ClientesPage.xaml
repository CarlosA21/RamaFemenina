<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.ClientesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Animaciones de entrada -->
        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="20" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Estilos modernos -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="16"/>
            <Setter Property="Padding" Value="24,20"/>
            <Setter Property="MinHeight" Value="140"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="MinWidth" Value="140"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="48"/>
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="24"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Gradientes -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11998e" Offset="0"/>
            <GradientStop Color="#38ef7d" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#eb3349" Offset="0"/>
            <GradientStop Color="#f45c43" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4facfe" Offset="0"/>
            <GradientStop Color="#00f2fe" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="BusinessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#f093fb" Offset="0"/>
            <GradientStop Color="#f5576c" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid x:Name="MainContent" Margin="0">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
            <Grid MaxWidth="1600">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header con Gradiente Premium -->
                <Border Grid.Row="0" 
                       CornerRadius="16" 
                       Padding="32,28"
                       Margin="0,0,0,24"
                       Background="{StaticResource BusinessGradient}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Spacing="8">
                            <StackPanel Orientation="Horizontal" Spacing="16">
                                <Viewbox Width="40" Height="40">
                                    <FontIcon Glyph="&#xE8D4;" Foreground="White"/>
                                </Viewbox>
                                <TextBlock Text="Gestión de Clientes Corporativos"
                                          FontSize="32"
                                          FontWeight="Bold"
                                          Foreground="White"
                                          VerticalAlignment="Center"/>
                            </StackPanel>
                            <TextBlock Text="Administra clientes empresariales, contactos comerciales y relaciones de negocio"
                                      FontSize="16"
                                      Foreground="#E3F2FD"
                                      Opacity="0.9"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" 
                                   VerticalAlignment="Center" 
                                   Orientation="Horizontal" 
                                   Spacing="12">
                            <Button Style="{StaticResource IconButton}"
                                   Background="#FFFFFF20"
                                   BorderThickness="0"
                                   Click="BtnActualizar_Click"
                                   ToolTipService.ToolTip="Actualizar lista">
                                <FontIcon Glyph="&#xE72C;" Foreground="White" FontSize="20"/>
                            </Button>
                            <Button Style="{StaticResource IconButton}"
                                   Background="#FFFFFF20"
                                   BorderThickness="0"
                                   ToolTipService.ToolTip="Exportar datos">
                                <FontIcon Glyph="&#xE8E5;" Foreground="White" FontSize="20"/>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tarjetas de Estadísticas -->
                <Grid Grid.Row="1" Margin="0,0,0,24">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Total Clientes -->
                    <Border Grid.Column="0" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource BusinessGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8D4;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtTotalClientes" 
                                          Text="0" 
                                          FontSize="36" 
                                          FontWeight="Bold"/>
                                <TextBlock Text="Total Clientes" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE74E;" FontSize="12" Foreground="#11998e"/>
                                <TextBlock Text="+8% este mes" FontSize="12" Foreground="#11998e"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Con RNC -->
                    <Border Grid.Column="2" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource SuccessGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8C7;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtConRnc" 
                                          Text="0" 
                                          FontSize="36" 
                                          FontWeight="Bold"/>
                                <TextBlock Text="Con RNC Registrado" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <ProgressBar Grid.Row="2" Value="75" Foreground="#11998e" Height="4"/>
                        </Grid>
                    </Border>

                    <!-- Contactos Completos -->
                    <Border Grid.Column="4" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource InfoGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE8A0;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtContactosCompletos" 
                                          Text="0" 
                                          FontSize="36" 
                                          FontWeight="Bold"/>
                                <TextBlock Text="Datos Completos" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Border Grid.Row="2" 
                                   Background="{ThemeResource AccentAAFillColorTertiaryBrush}"
                                   CornerRadius="8"
                                   Padding="8,4">
                                <TextBlock Text="100% verificados" FontSize="11" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Nuevos -->
                    <Border Grid.Column="6" Style="{StaticResource StatCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            
                            <Border Background="{StaticResource PrimaryGradient}"
                                   Width="56" Height="56"
                                   CornerRadius="12"
                                   HorizontalAlignment="Left">
                                <FontIcon Glyph="&#xE710;" Foreground="White" FontSize="28"/>
                            </Border>

                            <StackPanel Grid.Row="1" Margin="0,16,0,0">
                                <TextBlock x:Name="txtNuevos" 
                                          Text="0" 
                                          FontSize="36" 
                                          FontWeight="Bold"/>
                                <TextBlock Text="Agregados Hoy" 
                                          FontSize="14" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <TextBlock Grid.Row="2" 
                                      Text="📅 Últimas 24 horas" 
                                      FontSize="12" 
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Barra de Herramientas -->
                <Border Grid.Row="2" Style="{StaticResource ModernCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Búsqueda Avanzada -->
                        <Border Grid.Column="0" 
                               Background="{ThemeResource ControlFillColorDefaultBrush}"
                               CornerRadius="10"
                               Padding="16,0"
                               Height="52"
                               BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                               BorderThickness="1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <FontIcon Glyph="&#xE721;" 
                                         Grid.Column="0"
                                         Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                         FontSize="20"
                                         Margin="0,0,12,0"/>

                                <TextBox x:Name="txtBuscar"
                                        Grid.Column="1"
                                        PlaceholderText="Buscar clientes por nombre, RNC, teléfono o dirección..."
                                        TextChanged="TxtBuscar_TextChanged"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        VerticalAlignment="Center"/>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                                    <Button Style="{StaticResource IconButton}"
                                           Width="36" Height="36"
                                           Background="Transparent"
                                           ToolTipService.ToolTip="Filtros avanzados">
                                        <FontIcon Glyph="&#xE71C;" FontSize="16"/>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!-- Botones de Acción -->
                        <StackPanel Grid.Column="1" 
                                   Orientation="Horizontal" 
                                   Spacing="12" 
                                   Margin="20,0,0,0">
                            <Button x:Name="btnNuevo"
                                   Click="BtnNuevo_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="{StaticResource BusinessGradient}"
                                   Foreground="White"
                                   BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <FontIcon Glyph="&#xE710;" FontSize="18"/>
                                    <TextBlock Text="Nuevo Cliente" FontSize="14"/>
                                </StackPanel>
                            </Button>

                            <Button x:Name="btnActualizar"
                                   Click="BtnActualizar_Click"
                                   Style="{StaticResource ModernButton}"
                                   Background="{StaticResource SuccessGradient}"
                                   Foreground="White"
                                   BorderThickness="0">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon Glyph="&#xE72C;" FontSize="16"/>
                                    <TextBlock Text="Actualizar" FontSize="14"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Tabs de Vista -->
                <Border Grid.Row="3" 
                       Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                       CornerRadius="12"
                       Padding="8"
                       Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4">
                            <ToggleButton Content="📋 Lista" IsChecked="True" MinWidth="100" Height="40" CornerRadius="8"/>
                            <ToggleButton Content="🏢 Empresas" MinWidth="120" Height="40" CornerRadius="8"/>
                        </StackPanel>

                        <TextBlock Grid.Column="2" 
                                  x:Name="txtEstado"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0"
                                  Text="Listo"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </Grid>
                </Border>

                <!-- Lista de Clientes Premium -->
                <Border Grid.Row="4" Style="{StaticResource ModernCard}" MinHeight="400">
                    <Grid>
                        <!-- ListView - Solo visible cuando hay datos -->
                        <ScrollViewer HorizontalScrollBarVisibility="Auto" 
                                     VerticalScrollBarVisibility="Auto"
                                     x:Name="ListViewScroller"
                                     Visibility="Visible">
                            <ListView x:Name="lvClientes"
                                     SelectionMode="Single"
                                     IsItemClickEnabled="True"
                                     ItemClick="LvClientes_ItemClick"
                                     CornerRadius="8">
                                <ListView.ItemContainerStyle>
                                    <Style TargetType="ListViewItem">
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0,0,0,2"/>
                                    </Style>
                                </ListView.ItemContainerStyle>

                                <ListView.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                               CornerRadius="8,8,0,0"
                                               Padding="20,16"
                                               MinWidth="1200">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="220"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="ID" Grid.Column="0" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="NOMBRE / RAZÓN SOCIAL" Grid.Column="1" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="RNC" Grid.Column="2" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="TELÉFONO" Grid.Column="3" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="DIRECCIÓN" Grid.Column="4" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock Text="ACCIONES" Grid.Column="5" FontWeight="Bold" FontSize="12" Foreground="{ThemeResource TextFillColorSecondaryBrush}" TextAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.HeaderTemplate>

                                <ListView.ItemTemplate>
                                    <DataTemplate x:DataType="local:ClienteViewModel">
                                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                               CornerRadius="8"
                                               Padding="20,16"
                                               Margin="0,1"
                                               MinWidth="1200"
                                               BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                                               BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="80"/>
                                                    <ColumnDefinition Width="280"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="160"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="220"/>
                                                </Grid.ColumnDefinitions>

                                                <Border Grid.Column="0"
                                                       Background="{ThemeResource AccentAAFillColorTertiaryBrush}"
                                                       CornerRadius="8"
                                                       Padding="8,6"
                                                       HorizontalAlignment="Left"
                                                       VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind IdCliente}"
                                                              FontFamily="Consolas"
                                                              FontSize="12"
                                                              FontWeight="Bold"
                                                              TextAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Nombre}" 
                                                              FontWeight="SemiBold"
                                                              FontSize="14"
                                                              TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>

                                                <Border Grid.Column="2"
                                                       Background="{ThemeResource SystemFillColorSolidNeutralBrush}"
                                                       CornerRadius="8"
                                                       Padding="12,8"
                                                       VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind RncDisplay}"
                                                              FontSize="12"
                                                              FontWeight="Medium"
                                                              TextAlignment="Center"/>
                                                </Border>

                                                <StackPanel Grid.Column="3" VerticalAlignment="Center" Spacing="4">
                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <FontIcon Glyph="&#xE8C0;" FontSize="12" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="{x:Bind TelefonoDisplay}" FontSize="13"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <TextBlock Text="{x:Bind DireccionDisplay}" 
                                                          Grid.Column="4"
                                                          VerticalAlignment="Center"
                                                          FontSize="12"
                                                          FontStyle="Italic"
                                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                          TextTrimming="CharacterEllipsis"/>

                                                <StackPanel Grid.Column="5" 
                                                           Orientation="Horizontal" 
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           Spacing="8">
                                                    <Button Click="BtnEditar_Click"
                                                           Tag="{x:Bind IdCliente}"
                                                           Background="{ThemeResource SystemFillColorAttentionBrush}"
                                                           CornerRadius="8"
                                                           Padding="12,8"
                                                           ToolTipService.ToolTip="Editar cliente">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                                            <TextBlock Text="Editar" FontSize="12"/>
                                                        </StackPanel>
                                                    </Button>
                                                    
                                                    <Button Click="BtnEliminar_Click"
                                                           Tag="{x:Bind IdCliente}"
                                                           Background="{StaticResource DangerGradient}"
                                                           Foreground="White"
                                                           BorderThickness="0"
                                                           CornerRadius="8"
                                                           Padding="12,8"
                                                           ToolTipService.ToolTip="Eliminar cliente">
                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                            <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                                            <TextBlock Text="Eliminar" FontSize="12"/>
                                                        </StackPanel>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListView.ItemTemplate>
                            </ListView>
                        </ScrollViewer>

                        <!-- Empty State Ultra Moderno -->
                        <StackPanel x:Name="emptyState"
                                   Visibility="Collapsed"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   Spacing="32"
                                   Padding="40">
                            <Viewbox Width="200" Height="200">
                                <Grid>
                                    <Ellipse Fill="{StaticResource BusinessGradient}" Opacity="0.1"/>
                                    <FontIcon Glyph="&#xE8D4;" 
                                             Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                             FontSize="120"/>
                                </Grid>
                            </Viewbox>
                            
                            <StackPanel Spacing="12">
                                <TextBlock Text="No hay clientes registrados"
                                          FontSize="28"
                                          FontWeight="Bold"
                                          HorizontalAlignment="Center"/>
                                <TextBlock Text="Comienza agregando tu primer cliente corporativo para gestionar relaciones comerciales"
                                          HorizontalAlignment="Center"
                                          TextAlignment="Center"
                                          MaxWidth="500"
                                          TextWrapping="Wrap"
                                          FontSize="16"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <Button Click="BtnNuevo_Click"
                                   Background="{StaticResource BusinessGradient}"
                                   Foreground="White"
                                   BorderThickness="0"
                                   Height="56"
                                   MinWidth="220"
                                   CornerRadius="12"
                                   FontSize="16"
                                   FontWeight="SemiBold">
                                <StackPanel Orientation="Horizontal" Spacing="12">
                                    <FontIcon Glyph="&#xE710;" FontSize="20"/>
                                    <TextBlock Text="Agregar Primer Cliente"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </ScrollViewer>

        <!-- Modal Dialog Premium para Add/Edit -->
        <Grid x:Name="modalOverlay" 
              Visibility="Collapsed"
              Background="#DD000000">
            <Border Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}"
                   CornerRadius="16"
                   MaxWidth="700"
                   Margin="40"
                   VerticalAlignment="Center"
                   Padding="32">
                <Border.Shadow>
                    <ThemeShadow />
                </Border.Shadow>
                
                <StackPanel Spacing="20">
                    <!-- Dialog Header -->
                    <Grid>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource BusinessGradient}"
                                   Width="48" Height="48"
                                   CornerRadius="12">
                                <FontIcon Glyph="&#xE8D4;" Foreground="White" FontSize="24"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="txtModalTitle" 
                                          Text="Nuevo Cliente"
                                          FontSize="24"
                                          FontWeight="Bold"/>
                                <TextBlock Text="Complete la información del cliente" 
                                          FontSize="13"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>
                        
                        <Button Click="BtnCerrarModal_Click"
                               HorizontalAlignment="Right"
                               VerticalAlignment="Top"
                               Style="{StaticResource IconButton}"
                               Width="40" Height="40"
                               Background="Transparent">
                            <FontIcon Glyph="&#xE711;" FontSize="16"/>
                        </Button>
                    </Grid>

                    <!-- Form Fields -->
                    <StackPanel Spacing="16">
                        <TextBox x:Name="txtNombre"
                                Header="Nombre / Razón Social *"
                                PlaceholderText="Ingrese el nombre o razón social"
                                MaxLength="200"
                                CornerRadius="8"/>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            
                            <TextBox x:Name="txtRnc"
                                    Grid.Column="0"
                                    Header="RNC / Cédula"
                                    PlaceholderText="130-12345-6"
                                    MaxLength="20"
                                    CornerRadius="8"/>
                            
                            <TextBox x:Name="txtTelefono"
                                    Grid.Column="2"
                                    Header="Teléfono Principal"
                                    PlaceholderText="809-123-4567"
                                    MaxLength="20"
                                    CornerRadius="8"/>
                        </Grid>

                        <TextBox x:Name="txtDireccion"
                                Header="Dirección Comercial"
                                PlaceholderText="Calle, número, sector, ciudad, provincia"
                                TextWrapping="Wrap"
                                AcceptsReturn="True"
                                Height="90"
                                MaxLength="500"
                                CornerRadius="8"/>
                    </StackPanel>

                    <Border Background="{ThemeResource SystemFillColorAttentionBackgroundBrush}"
                           CornerRadius="8"
                           Padding="12">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE946;" FontSize="16" Foreground="{ThemeResource SystemFillColorAttentionBrush}"/>
                            <TextBlock Text="* Los campos marcados son obligatorios"
                                      FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Action Buttons -->
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="16"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Button x:Name="btnGuardar"
                               Grid.Column="0"
                               Click="BtnGuardar_Click"
                               Background="{StaticResource BusinessGradient}"
                               Foreground="White"
                               BorderThickness="0"
                               Height="52"
