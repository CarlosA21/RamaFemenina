<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.BlankPage1"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Estilos personalizados -->
        <Style x:Key="ModernCardBorder" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <ThemeShadow />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="GradientButton" TargetType="Button">
            <Setter Property="Height" Value="48"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Margin" Value="0,4"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Shadow">
                <Setter.Value>
                    <ThemeShadow />
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ModernTextBox" TargetType="TextBox">
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="FontSize" Value="14"/>
        </Style>

        <Style x:Key="IconTextBlock" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons"/>
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,0,12,0"/>
        </Style>

        <!-- Gradientes para botones -->
        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#56ab2f" Offset="0"/>
            <GradientStop Color="#a8e6cf" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ff6b6b" Offset="0"/>
            <GradientStop Color="#ee5a52" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4facfe" Offset="0"/>
            <GradientStop Color="#00f2fe" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#ffa726" Offset="0"/>
            <GradientStop Color="#ffcc02" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <ScrollViewer x:Name="MainScrollViewer" ZoomMode="Disabled" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
        <Grid Margin="24" MaxWidth="1400">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Header Section -->
            <Border Grid.Row="0" Style="{StaticResource ModernCardBorder}" Background="{StaticResource PrimaryGradient}">
                <StackPanel HorizontalAlignment="Center" Spacing="8">
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <TextBlock Text="&#xE8C7;" Style="{StaticResource IconTextBlock}" Foreground="White" FontSize="32"/>
                        <TextBlock Text="Sistema de Facturación" 
                                  FontSize="28" 
                                  FontWeight="Bold" 
                                  Foreground="White"
                                  VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="Generador de Recibos y Comprobantes Fiscales" 
                              FontSize="16" 
                              Foreground="#E3F2FD"
                              HorizontalAlignment="Center"
                              Opacity="0.9"/>
                    <TextBlock Text="Rama Femenina Contra el Cáncer" 
                              FontSize="14" 
                              Foreground="#E3F2FD"
                              HorizontalAlignment="Center"
                              FontWeight="Light"
                              Opacity="0.8"/>
                </StackPanel>
            </Border>

            <!-- Main Content -->
            <Grid Grid.Row="1" x:Name="btnPanel" Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" MinWidth="400"/>
                    <ColumnDefinition Width="20"/>
                    <ColumnDefinition Width="3*" MinWidth="500"/>
                </Grid.ColumnDefinitions>

                <!-- Columna Izquierda - Generador de Facturas -->
                <ScrollViewer Grid.Column="0" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource ModernCardBorder}">
                        <StackPanel Spacing="16">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="&#xE8C7;" Style="{StaticResource IconTextBlock}" Foreground="{StaticResource WarningGradient}"/>
                                <TextBlock Text="Generador de Facturas" 
                                          FontSize="20" 
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Información del Cliente para Factura -->
                            <StackPanel Spacing="12">
                                <TextBlock Text="Información del Cliente" 
                                          FontSize="16" 
                                          FontWeight="SemiBold"
                                          Foreground="{ThemeResource TextFillColorPrimaryBrush}"/>
                                
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtFacturaRncCliente" 
                                            Grid.Column="0"
                                            Style="{StaticResource ModernTextBox}"
                                            Header="RNC Cliente" 
                                            PlaceholderText="130-12345-6"/>
                                    <TextBox x:Name="txtFacturaTelefono" 
                                            Grid.Column="2"
                                            Style="{StaticResource ModernTextBox}"
                                            Header="Teléfono" 
                                            PlaceholderText="809-123-4567"/>
                                </Grid>

                                <TextBox x:Name="txtFacturaNombreCliente" 
                                        Style="{StaticResource ModernTextBox}"
                                        Header="Nombre/Razón Social" 
                                        PlaceholderText="Nombre completo o razón social"/>

                                <TextBox x:Name="txtFacturaDireccion" 
                                        Style="{StaticResource ModernTextBox}"
                                        Header="Dirección Completa" 
                                        PlaceholderText="Calle, número, sector, ciudad"
                                        TextWrapping="Wrap"/>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="8"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtFacturaNCF" 
                                            Grid.Column="0"
                                            Style="{StaticResource ModernTextBox}"
                                            Header="NCF" 
                                            PlaceholderText="B0100000001"/>
                                    <DatePicker x:Name="dpFacturaValidaHasta" 
                                               Grid.Column="2"
                                               Header="Válida Hasta"
                                               CornerRadius="8"/>
                                </Grid>

                                <Button x:Name="btnGenerarFactura" 
                                       Click="GenerarFactura_Click"
                                       Style="{StaticResource GradientButton}"
                                       Background="{StaticResource WarningGradient}">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
                                        <TextBlock Text="Generar Factura Fiscal"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>

                <!-- Columna Derecha - Generador de Recibos -->
                <ScrollViewer Grid.Column="2" VerticalScrollMode="Auto" VerticalScrollBarVisibility="Auto">
                    <Border Style="{StaticResource ModernCardBorder}">
                        <StackPanel Spacing="20">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <TextBlock Text="&#xE8C7;" Style="{StaticResource IconTextBlock}" Foreground="{StaticResource SuccessGradient}"/>
                                <TextBlock Text="Generador de Recibos" 
                                          FontSize="20" 
                                          FontWeight="SemiBold"
                                          VerticalAlignment="Center"/>
                            </StackPanel>

                            <!-- Formulario Principal -->
                            <StackPanel Spacing="16">
                                <!-- Fila 1: Número y Fecha -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtNumeroRecibo" 
                                            Grid.Column="0"
                                            Style="{StaticResource ModernTextBox}"
                                            Header="Número de Recibo"
                                            PlaceholderText="000001"
                                            InputScope="Number"/>
                                    <DatePicker x:Name="dpFecha" 
                                               Grid.Column="2"
                                               Header="Fecha de Emisión"
                                               CornerRadius="8"/>
                                </Grid>

                                <!-- Beneficiario -->
                                <TextBox x:Name="txtNombre" 
                                        Style="{StaticResource ModernTextBox}"
                                        Header="Beneficiario / Pagador"
                                        PlaceholderText="Nombre completo del beneficiario"/>

                                <!-- Fila 2: Cédula y Monto -->
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="1*"/>
                                        <ColumnDefinition Width="12"/>
                                        <ColumnDefinition Width="1*"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="txtCedula" 
                                            Grid.Column="0"
                                            Style="{StaticResource ModernTextBox}"
                                            Header="Cédula / RNC"
                                            PlaceholderText="001-1234567-8"/>
                                    <TextBox x:Name="txtMonto" 
                                            Grid.Column="2"
                                            Style="{StaticResource ModernTextBox}"
                                            Header="Monto (RD$)"
                                            PlaceholderText="0.00"
                                            InputScope="Number"/>
                                </Grid>

                                <!-- Monto en Letras -->
                                <TextBox x:Name="txtMontoLetras" 
                                        Style="{StaticResource ModernTextBox}"
                                        Header="Monto en Letras"
                                        PlaceholderText="Se generará automáticamente"
                                        TextWrapping="Wrap"/>

                                <!-- Concepto -->
                                <TextBox x:Name="txtConcepto" 
                                        Style="{StaticResource ModernTextBox}"
                                        Header="Concepto del Recibo"
                                        PlaceholderText="Descripción detallada del concepto"/>

                                <!-- Información Adicional -->
                                <Expander Header="Información Adicional" 
                                         IsExpanded="False"
                                         CornerRadius="8"
                                         Background="{ThemeResource LayerFillColorDefaultBrush}">
                                    <Expander.HeaderTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
                                                <TextBlock Text="Información Adicional" FontWeight="SemiBold"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </Expander.HeaderTemplate>
                                    
                                    <StackPanel Spacing="16" Margin="0,16,0,0">
                                        <!-- Información Bancaria -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtNumeroCheque" 
                                                    Grid.Column="0"
                                                    Style="{StaticResource ModernTextBox}"
                                                    Header="Número de Cheque"/>
                                            <TextBox x:Name="txtBanco" 
                                                    Grid.Column="2"
                                                    Style="{StaticResource ModernTextBox}"
                                                    Header="Banco Emisor"/>
                                        </Grid>

                                        <!-- Información Fiscal -->
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="12"/>
                                                <ColumnDefinition Width="1*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBox x:Name="txtNCF" 
                                                    Grid.Column="0"
                                                    Style="{StaticResource ModernTextBox}"
                                                    Header="NCF / Factura"/>
                                            <TextBox x:Name="txtCargoA" 
                                                    Grid.Column="2"
                                                    Style="{StaticResource ModernTextBox}"
                                                    Header="Con Cargo a"/>
                                        </Grid>

                                        <!-- Forma de Pago -->
                                        <StackPanel Spacing="12">
                                            <TextBlock Text="Método de Pago" 
                                                      FontWeight="SemiBold" 
                                                      FontSize="14"/>
                                            <Border Background="{ThemeResource LayerFillColorDefaultBrush}" 
                                                   CornerRadius="8" 
                                                   Padding="16,12">
                                                <StackPanel Orientation="Horizontal" Spacing="24">
                                                    <CheckBox x:Name="chkEfectivo" 
                                                             Content="Efectivo"
                                                             FontWeight="Medium"/>
                                                    <CheckBox x:Name="chkCheque" 
                                                             Content="Cheque"
                                                             FontWeight="Medium"/>
                                                    <CheckBox x:Name="chkTransferencia" 
                                                             Content="Transferencia"
                                                             FontWeight="Medium"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                </Expander>

                                <!-- Botones de Acción -->
                                <StackPanel Spacing="12" Margin="0,20,0,0">
                                    <TextBlock Text="Tipos de Recibo" 
                                              FontWeight="SemiBold" 
                                              FontSize="16"
                                              Margin="0,0,0,8"/>
                                    
                                    <Button x:Name="btnReciboIngresos" 
                                           Click="GenerarReciboIngresos_Click"
                                           Style="{StaticResource GradientButton}"
                                           Background="{StaticResource SuccessGradient}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#xE8A5;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
                                            <TextBlock Text="Recibo Simple de Ingresos"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnReciboCompleto" 
                                           Click="GenerarReciboCompleto_Click"
                                           Style="{StaticResource GradientButton}"
                                           Background="{StaticResource InfoGradient}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#xE8C7;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
                                            <TextBlock Text="Recibo Completo con Detalles"/>
                                        </StackPanel>
                                    </Button>

                                    <Button x:Name="btnReciboDesembolso" 
                                           Click="GenerarReciboDesembolso_Click"
                                           Style="{StaticResource GradientButton}"
                                           Background="{StaticResource DangerGradient}">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#xE8C8;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
                                            <TextBlock Text="Comprobante de Desembolso"/>
                                        </StackPanel>
                                    </Button>

                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" Margin="0,8"/>

                                    <Button x:Name="btnLimpiar" 
                                           Click="LimpiarFormulario_Click"
                                           Style="{StaticResource GradientButton}"
                                           Background="{ThemeResource SystemFillColorNeutralBrush}"
                                           Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                                           BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                           BorderThickness="1">
                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                            <TextBlock Text="&#xE894;" FontFamily="Segoe Fluent Icons" FontSize="16"/>
                                            <TextBlock Text="Limpiar Formulario"/>
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </ScrollViewer>
            </Grid>

            <!-- Status Bar Moderno -->
            <Border Grid.Row="2" 
                   Style="{StaticResource ModernCardBorder}"
                   Background="{ThemeResource LayerFillColorDefaultBrush}"
                   Margin="0,20,0,0"
                   Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
                        <ProgressRing x:Name="progressRing" 
                                     IsActive="False" 
                                     Width="24" 
                                     Height="24"/>
                        <TextBlock x:Name="txtStatus" 
                                  Text="Sistema listo para generar documentos" 
                                  VerticalAlignment="Center" 
                                  FontSize="14"
                                  FontWeight="Medium"/>
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="16">
                        <TextBlock Text="🏥" FontSize="16" VerticalAlignment="Center"/>
                        <TextBlock Text="Rama Femenina Contra el Cáncer" 
                                  FontSize="12"
                                  VerticalAlignment="Center"
                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </ScrollViewer>
</Page>
