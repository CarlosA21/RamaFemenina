<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="RamaFemenina.ChequesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:RamaFemenina"
    xmlns:models="using:RamaFemenina.Models"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Page.Resources>
        <!-- Animaciones -->
        <Storyboard x:Name="FadeInStoryboard">
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="Opacity"
                           From="0" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
            <DoubleAnimation Storyboard.TargetName="MainContent"
                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)"
                           From="20" To="0" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                    <CubicEase EasingMode="EaseOut"/>
                </DoubleAnimation.EasingFunction>
            </DoubleAnimation>
        </Storyboard>

        <!-- Estilos -->
        <Style x:Key="ModernCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0,0,0,16"/>
        </Style>

        <Style x:Key="StatCard" TargetType="Border">
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="MinHeight" Value="120"/>
        </Style>

        <Style x:Key="ModernButton" TargetType="Button">
            <Setter Property="Height" Value="44"/>
            <Setter Property="MinWidth" Value="120"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="4"/>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="Width" Value="40"/>
            <Setter Property="Height" Value="40"/>
            <Setter Property="CornerRadius" Value="20"/>
            <Setter Property="Padding" Value="0"/>
        </Style>

        <!-- Gradientes -->
        <LinearGradientBrush x:Key="ChequeGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#43C6AC" Offset="0"/>
            <GradientStop Color="#191654" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="PrimaryGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#4facfe" Offset="0"/>
            <GradientStop Color="#00f2fe" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="SuccessGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#11998e" Offset="0"/>
            <GradientStop Color="#38ef7d" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="DangerGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#eb3349" Offset="0"/>
            <GradientStop Color="#f45c43" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="WarningGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#f2994a" Offset="0"/>
            <GradientStop Color="#f2c94c" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="InfoGradient" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#667eea" Offset="0"/>
            <GradientStop Color="#764ba2" Offset="1"/>
        </LinearGradientBrush>
    </Page.Resources>

    <Grid x:Name="MainContent">
        <Grid.RenderTransform>
            <TranslateTransform Y="0"/>
        </Grid.RenderTransform>

        <Grid Padding="24,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Header Mejorado -->
            <Border Grid.Row="0" 
                   CornerRadius="16" 
                   Padding="32,24"
                   Margin="0,0,0,20"
                   Background="{StaticResource ChequeGradient}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Spacing="6">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Border Background="#FFFFFF30" 
                                   Width="48" Height="48" 
                                   CornerRadius="12"
                                   Padding="10">
                                <FontIcon Glyph="&#xE8C7;" Foreground="White" FontSize="24"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Gestión de Cheques"
                                          FontSize="28"
                                          FontWeight="Bold"
                                          Foreground="White"/>
                                <TextBlock Text="Administra y controla todos los cheques emitidos por la organización"
                                          FontSize="14"
                                          Foreground="#E8EAED"
                                          Opacity="0.9"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1" 
                               VerticalAlignment="Center" 
                               Orientation="Horizontal" 
                               Spacing="8">
                        <Button Style="{StaticResource IconButton}"
                               Background="#FFFFFF20"
                               BorderThickness="0"
                               ToolTipService.ToolTip="Generar reporte">
                            <FontIcon Glyph="&#xE8A2;" Foreground="White" FontSize="18"/>
                        </Button>
                        <Button Style="{StaticResource IconButton}"
                               Background="#FFFFFF20"
                               BorderThickness="0"
                               ToolTipService.ToolTip="Exportar datos">
                            <FontIcon Glyph="&#xE896;" Foreground="White" FontSize="18"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Estadísticas Mejoradas 
            <Grid Grid.Row="1" Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                 Total Cheques 
                <Border Grid.Column="0" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource ChequeGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE8C7;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Total Cheques" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtTotalCheques" 
                                          Text="0" 
                                          FontSize="28" 
                                          FontWeight="Bold"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                Monto Total 
                <Border Grid.Column="2" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource SuccessGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE8EC;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Monto Total" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtMontoTotal" 
                                          Text="RD$ 0.00" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="#11998e"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                 Promedio 
                <Border Grid.Column="4" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource InfoGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE8B3;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Monto Promedio" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtPromedio" 
                                          Text="RD$ 0.00" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="#667eea"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                 Este Mes 
                <Border Grid.Column="6" Style="{StaticResource StatCard}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="12">
                            <Border Background="{StaticResource WarningGradient}"
                                   Width="44" Height="44"
                                   CornerRadius="10">
                                <FontIcon Glyph="&#xE787;" Foreground="White" FontSize="20"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Este Mes" 
                                          FontSize="12" 
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                <TextBlock x:Name="txtEsteMes" 
                                          Text="RD$ 0.00" 
                                          FontSize="24" 
                                          FontWeight="Bold"
                                          Foreground="#f2994a"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid> -->

            <!-- Contenido Principal -->
            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Panel Principal de Lista -->
                <Border Style="{StaticResource ModernCard}" Margin="0">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Barra de Herramientas -->
                        <Grid Grid.Row="0" Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Búsqueda -->
                            <Border Grid.Column="0" 
                                   Background="{ThemeResource ControlFillColorDefaultBrush}"
                                   CornerRadius="8"
                                   Padding="12,0"
                                   Height="44"
                                   BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                   BorderThickness="1"
                                   Margin="0,0,12,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <FontIcon Glyph="&#xE721;" 
                                             Grid.Column="0"
                                             Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                             FontSize="16"
                                             Margin="0,0,8,0"/>

                                    <AutoSuggestBox x:Name="SearchBox"
                                                   Grid.Column="1"
                                                   PlaceholderText="Buscar por número, beneficiario, monto o concepto..."
                                                   TextChanged="SearchBox_TextChanged"
                                                   Background="Transparent"
                                                   BorderThickness="0"
                                                   VerticalAlignment="Center"/>
                                </Grid>
                            </Border>

                            <!-- Botones de Acción -->
                            <StackPanel Grid.Column="1" 
                                       Orientation="Horizontal" 
                                       Spacing="8">
                                <Button Click="BtnNuevoCheque_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="{StaticResource ChequeGradient}"
                                       Foreground="White"
                                       BorderThickness="0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <FontIcon Glyph="&#xE710;" FontSize="16"/>
                                        <TextBlock Text="Nuevo" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnEditar"
                                       Click="BtnEditarCheque_Click"
                                       Style="{StaticResource ModernButton}"
                                       IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE70F;" FontSize="14"/>
                                        <TextBlock Text="Editar" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnImprimir"
                                       Click="BtnImprimirCheque_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="{StaticResource PrimaryGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       IsEnabled="False">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <FontIcon Glyph="&#xE749;" FontSize="14"/>
                                        <TextBlock Text="Imprimir" FontSize="13"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnEliminar"
                                       Click="BtnEliminarCheque_Click"
                                       Style="{StaticResource ModernButton}"
                                       Background="{StaticResource DangerGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       IsEnabled="False">
                                    <FontIcon Glyph="&#xE74D;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Filtros 
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,16">
                            <ComboBox Header="Ordenar por"
                                     MinWidth="180"
                                     CornerRadius="8">
                                <ComboBoxItem Content="📅 Fecha (Reciente)" IsSelected="True"/>
                                <ComboBoxItem Content="📅 Fecha (Antigua)"/>
                                <ComboBoxItem Content="💰 Monto (Mayor)"/>
                                <ComboBoxItem Content="💰 Monto (Menor)"/>
                                <ComboBoxItem Content="🔢 Número de Cheque"/>
                            </ComboBox>

                            <Border VerticalAlignment="Bottom" 
                                   Background="{ThemeResource SystemFillColorSolidNeutralBackgroundBrush}"
                                   CornerRadius="6"
                                   Padding="12,8"
                                   Margin="0,0,0,2">
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}">
                                    <Run Text="Total:"/>
                                    <Run x:Name="txtContador" Text="0" FontWeight="Bold"/>
                                    <Run Text="cheques"/>
                                </TextBlock>
                            </Border>
                        </StackPanel> -->

                        <!-- Separador -->
                        <Border Grid.Row="2" 
                               Height="1" 
                               Background="{ThemeResource DividerStrokeColorDefaultBrush}"
                               Margin="0,0,0,16"/>

                        <!-- Lista de Cheques -->
                        <Grid Grid.Row="3">
                            <ScrollViewer x:Name="ListViewScroller"
                                         VerticalScrollBarVisibility="Auto">
                                <ListView x:Name="ChequesListView"
                                         SelectionMode="Single"
                                         SelectionChanged="ChequesListView_SelectionChanged">
                                    <ListView.ItemContainerStyle>
                                        <Style TargetType="ListViewItem">
                                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                            <Setter Property="Padding" Value="12"/>
                                            <Setter Property="Margin" Value="0,0,0,8"/>
                                        </Style>
                                    </ListView.ItemContainerStyle>

                                    <ListView.ItemTemplate>
                                        <DataTemplate x:DataType="models:Cheques">
                                            <Border Background="{ThemeResource CardBackgroundFillColorSecondaryBrush}"
                                                   CornerRadius="10"
                                                   Padding="20,16"
                                                   BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                                   BorderThickness="1">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <!-- ID del Cheque -->
                                                    <Border Grid.Column="0"
                                                           Background="{StaticResource ChequeGradient}"
                                                           CornerRadius="8"
                                                           Padding="10,6"
                                                           Margin="0,0,16,0"
                                                           VerticalAlignment="Center">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="💳" FontSize="12"/>
                                                            <TextBlock Text="{x:Bind idCheque}"
                                                                      FontSize="11"
                                                                      FontWeight="SemiBold"
                                                                      Foreground="White"/>
                                                        </StackPanel>
                                                    </Border>

                                                    <!-- Número y Fecha -->
                                                    <StackPanel Grid.Column="1" 
                                                               VerticalAlignment="Center"
                                                               Spacing="4"
                                                               Margin="0,0,20,0"
                                                               MinWidth="140">
                                                        <TextBlock Text="{x:Bind numero}"
                                                                  FontFamily="Consolas"
                                                                  FontSize="15"
                                                                  FontWeight="Bold"
                                                                  Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"/>
                                                        <TextBlock Text="{x:Bind FechaFormateada}" 
                                                                  FontSize="11"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                                    </StackPanel>

                                                    <!-- Información Principal -->
                                                    <StackPanel Grid.Column="2" 
                                                               VerticalAlignment="Center"
                                                               Spacing="6">
                                                        <TextBlock Text="{x:Bind nombre}" 
                                                                  FontSize="15"
                                                                  FontWeight="SemiBold"
                                                                  TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Text="{x:Bind ConceptoSeguro}" 
                                                                  FontSize="12"
                                                                  FontStyle="Italic"
                                                                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                  TextTrimming="CharacterEllipsis"
                                                                  MaxWidth="400"/>
                                                    </StackPanel>

                                                    <!-- Monto -->
                                                    <StackPanel Grid.Column="3" 
                                                               VerticalAlignment="Center"
                                                               HorizontalAlignment="Right"
                                                               Margin="20,0,0,0">
                                                        <TextBlock FontSize="20" 
                                                                  FontWeight="Bold"
                                                                  TextAlignment="Right">
                                                            <Run Text="RD$ "/>
                                                            <Run Text="{x:Bind monto}" Foreground="#11998e"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListView.ItemTemplate>
                                </ListView>
                            </ScrollViewer>

                            <!-- Empty State -->
                            <StackPanel x:Name="EmptyState"
                                       Visibility="Collapsed"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Spacing="24"
                                       Padding="40">
                                <Border Background="{StaticResource ChequeGradient}"
                                       Width="120" Height="120"
                                       CornerRadius="60"
                                       Opacity="0.1"/>
                                <FontIcon Glyph="&#xE8C7;" 
                                         FontSize="80"
                                         Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                         Margin="0,-140,0,60"/>

                                <StackPanel Spacing="8">
                                    <TextBlock Text="No hay cheques registrados"
                                              FontSize="24"
                                              FontWeight="SemiBold"
                                              HorizontalAlignment="Center"/>
                                    <TextBlock Text="Comienza emitiendo tu primer cheque"
                                              HorizontalAlignment="Center"
                                              FontSize="14"
                                              Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
                                </StackPanel>

                                <Button Click="BtnNuevoCheque_Click"
                                       Background="{StaticResource ChequeGradient}"
                                       Foreground="White"
                                       BorderThickness="0"
                                       Height="48"
                                       MinWidth="180"
                                       CornerRadius="8"
                                       FontSize="15"
                                       FontWeight="SemiBold">
                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <FontIcon Glyph="&#xE710;" FontSize="18"/>
                                        <TextBlock Text="Crear Cheque"/>
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!-- Paginación -->
                        <Grid Grid.Row="4"
                             Margin="0,16,0,0"
                             Padding="0,12,0,0"
                             BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                             BorderThickness="0,1,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <!-- Info de Página -->
                            <StackPanel Grid.Column="0" 
                                       Orientation="Horizontal" 
                                       Spacing="8"
                                       VerticalAlignment="Center">
                                <Border Background="{StaticResource ChequeGradient}"
                                       CornerRadius="6"
                                       Padding="10,6">
                                    <TextBlock x:Name="txtPageInfo"
                                              Text="Página 1 de 1"
                                              FontSize="12"
                                              FontWeight="SemiBold"
                                              Foreground="White"/>
                                </Border>

                                <Button Click="BtnActualizar_Click"
                                       Style="{StaticResource IconButton}"
                                       Background="{ThemeResource ControlFillColorDefaultBrush}"
                                       ToolTipService.ToolTip="Actualizar">
                                    <FontIcon Glyph="&#xE72C;" FontSize="14"/>
                                </Button>
                            </StackPanel>

                            <!-- Botones de Navegación -->
                            <StackPanel Grid.Column="2" 
                                       Orientation="Horizontal" 
                                       Spacing="6"
                                       VerticalAlignment="Center">
                                <Button x:Name="btnFirstPage"
                                       Click="BtnFirstPage_Click"
                                       Style="{StaticResource IconButton}"
                                       IsEnabled="False"
                                       ToolTipService.ToolTip="Primera">
                                    <FontIcon Glyph="&#xE892;" FontSize="14"/>
                                </Button>

                                <Button x:Name="btnPreviousPage"
                                       Click="BtnPreviousPage_Click"
                                       IsEnabled="False"
                                       Width="70"
                                       Height="40"
                                       CornerRadius="8"
                                       ToolTipService.ToolTip="Anterior">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <FontIcon Glyph="&#xE76B;" FontSize="12"/>
                                        <TextBlock Text="Ant" FontSize="12" FontWeight="SemiBold"/>
                                    </StackPanel>
                                </Button>

                                <Border Background="{ThemeResource AccentFillColorSelectedTextBackgroundBrush}"
                                       CornerRadius="8"
                                       Padding="14,10"
                                       MinWidth="50">
                                    <TextBlock Text="1"
                                              FontSize="14"
                                              FontWeight="Bold"
                                              Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                              HorizontalAlignment="Center"/>
                                </Border>

                                <Button x:Name="btnNextPage"
                                       Click="BtnNextPage_Click"
                                       IsEnabled="False"
                                       Width="70"
                                       Height="40"
                                       CornerRadius="8"
                                       ToolTipService.ToolTip="Siguiente">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <TextBlock Text="Sig" FontSize="12" FontWeight="SemiBold"/>
                                        <FontIcon Glyph="&#xE76C;" FontSize="12"/>
                                    </StackPanel>
                                </Button>

                                <Button x:Name="btnLastPage"
                                       Click="BtnLastPage_Click"
                                       Style="{StaticResource IconButton}"
                                       IsEnabled="False"
                                       ToolTipService.ToolTip="Última">
                                    <FontIcon Glyph="&#xE893;" FontSize="14"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- Loading Indicator -->
        <Grid x:Name="LoadingOverlay"
             Background="#80000000"
             Visibility="Collapsed">
            <StackPanel HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Spacing="16">
                <ProgressRing x:Name="LoadingIndicator"
                             IsActive="False"
                             Width="60"
                             Height="60"
                             Foreground="White"/>
                <TextBlock Text="Cargando cheques..."
                          Foreground="White"
                          FontSize="16"
                          HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>
    </Grid>
</Page>
